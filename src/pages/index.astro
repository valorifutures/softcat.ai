---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ActivityTicker from '../components/ActivityTicker.astro';
import { getCollection } from 'astro:content';
import feralManifest from '../content/feral/manifest.json';
const thoughts = (await getCollection('thoughts')).filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = thoughts.filter((entry) => entry.data.tags.includes('field-notes'));
const latestNote = notes[0];
const archive = thoughts.filter((entry) => !entry.data.tags.includes('field-notes')).slice(0, 2);
const fmt = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const experiments = [
  { index: '02', title: 'Prompt Workbench', text: 'Build, compare and keep the prompts that earn their place.', href: '/lab/prompt-workbench', category: 'MAKE SOMETHING', glyph: '{ }', colour: 'cyan' },
  { index: '03', title: 'JSON Output Validator', text: 'Check what a model returned before your next step depends on it.', href: '/lab/json-validator', category: 'CHECK THE OUTPUT', glyph: '✓', colour: 'lilac' },
  { index: '04', title: 'Agent Trace Tape', text: 'Explore a visual artefact of the pipeline, one recorded step at a time.', href: '/trace/', category: 'LOOK UNDERNEATH', glyph: '≋', colour: 'peach' },
];
---
<BaseLayout description="An independent AI workshop by Valori. Useful browser tools, inspectable agent experiments and a public notebook of what we learn.">
  <Hero />
  <ActivityTicker />

  <section class="workshop-shell workshop-section" aria-labelledby="bench-heading">
    <div class="workshop-section-heading"><div><p class="eyebrow">THE WORKBENCH</p><h2 id="bench-heading">Less watching. More trying.</h2></div><a class="text-link" href="/tools">All tools <span aria-hidden="true">↗</span></a></div>
    <div class="experiment-grid">{experiments.map((experiment) => <a class={`bench-card ${experiment.colour}`} href={experiment.href}>
      <div class="bench-meta"><span>{experiment.category}</span><span>{experiment.index}</span></div>
      <div class="bench-glyph" aria-hidden="true">{experiment.glyph}</div>
      <h3>{experiment.title}</h3><p>{experiment.text}</p><span class="bench-open">Open experiment <span aria-hidden="true">↗</span></span>
    </a>)}</div>
  </section>

  <section class="workshop-shell workshop-section" aria-labelledby="notebook-heading">
    <div class="workshop-section-heading"><div><p class="eyebrow">NOTES FROM THE WORKSHOP</p><h2 id="notebook-heading">The work, including the rough edges.</h2></div><a class="text-link" href="/notebook">The notebook <span aria-hidden="true">↗</span></a></div>
    {latestNote && <a class="notebook-feature" href={`/thoughts/${latestNote.id}`}>
      <div class="notebook-date"><span>FIELD NOTE</span><time datetime={latestNote.data.date.toISOString()}>{fmt(latestNote.data.date)}</time><span class="notebook-mark" aria-hidden="true">↳</span></div>
      <div><h3>{latestNote.data.title}</h3><p>{latestNote.data.summary}</p><span class="text-link">Read the entry <span aria-hidden="true">→</span></span></div>
    </a>}
    <div class="archive-note"><span class="eyebrow">FROM THE ARCHIVE</span><a href="/thoughts" class="text-link">All thoughts →</a></div>
    <div class="archive-grid">{archive.map((entry) => <a href={`/thoughts/${entry.id}`}><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time><h3>{entry.data.title}</h3></a>)}</div>
  </section>

  <section class="workshop-shell workshop-section horizon-feral" aria-label="Explore the wider experiment">
    <a href="/horizon" class="horizon-invitation">
      <p class="eyebrow">THE HORIZON MAP</p><h2>Keep the past.<br />Question the next.</h2>
      <p>A dated map of AI milestones, present signals and possible futures. Follow the evidence and the uncertainty.</p>
      <div class="horizon-lanes" aria-hidden="true"><span>PAST</span><span>NOW</span><span>NEXT ↗</span></div>
    </a>
    <a href="/feral" class="feral-invitation">
      <p class="eyebrow">THE UNSUPERVISED CORNER</p><h2>/feral<span aria-hidden="true">_</span></h2>
      <p>What do agents make when they choose the brief? Step inside the experiment and inspect what they left behind.</p>
      <div class="feral-bottom"><span>{feralManifest.length} published creations</span><span aria-hidden="true">↗</span></div>
    </a>
  </section>

  <section class="workshop-shell workshop-about">
    <div><p class="eyebrow">SMART OUTPUTS FROM TRAINED<br />CONVERSATIONAL AI TECHNOLOGY</p><h2>That is the name.<br />Useful is the aim.</h2></div>
    <div><p>SOFT CAT is an independent project by Valori. Part playground, part field notebook, part experiment in maintaining a website with AI.</p><p>We publish the code and the records, keep the failed attempts in view, and change our minds when the work calls for it.</p><a href="/valori" class="text-link">Meet the project →</a></div>
  </section>
</BaseLayout>
