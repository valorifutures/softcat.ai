---
import ModelDataNotice from '../../components/ModelDataNotice.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TokenCostCalculator from '../../components/lab/TokenCostCalculator';
import models from '../../data/models.json';
import { hasVerifiedPrice } from '../../lib/model-pricing.mjs';
const pricedModels = models.filter(hasVerifiedPrice).map(({ id, name, provider, inputPrice, outputPrice, pricingStatus, pricingCheckedAt, pricingSource, context }) => ({ id, name, provider, inputPrice, outputPrice, pricingStatus, pricingCheckedAt, pricingSource, context }));
---
<BaseLayout title="Token Cost Calculator" description="Estimate text-token costs for a request or growing conversation, including repeated system instructions and history. Inspect every parsed message and keep the assumptions.">
  <div class="token-page workshop-shell">
    <header><a href="/tools" class="text-link">← Tools</a><p class="eyebrow">A ROUGH COUNT. A CLEAR ASSUMPTION.</p><h1>The history<br /><em>comes back on the bill.</em></h1><p>Estimate the cost of supplied text. For a conversation, follow what gets sent again on each call and see which reply costs are still missing.</p></header>
    <ModelDataNotice />
    <TokenCostCalculator models={pricedModels} client:load />
  </div>
</BaseLayout>
<style>
  .token-page { max-width: 1000px; padding-block: 3.5rem 5rem; }
  header { max-width: 800px; margin-bottom: 2rem; }
  header > .eyebrow { margin-top: 2rem; }
  h1 { font: 600 clamp(2.4rem, 6vw, 4rem)/1.15 var(--font-sans); color: #eeeee5; letter-spacing: -.05em; margin-block: 1rem 1.5rem; }
  h1 em { color: var(--workshop-lime); font-style: normal; }
  header > p:not(.eyebrow) { color: #bcc5b1; font-size: 1rem; line-height: 1.9; }
</style>
