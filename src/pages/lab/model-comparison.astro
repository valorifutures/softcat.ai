---
import ModelDataNotice from '../../components/ModelDataNotice.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModelComparison from '../../components/lab/ModelComparison';
---

<BaseLayout title="Model Comparison" description="Compare saved model prices against your own workload. Adjust token counts, inspect the sources and export the results.">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <header class="mb-8">
      <a href="/tools" class="font-mono text-sm text-text-muted hover:text-neon-cyan transition-colors mb-4 inline-block">&larr; tools</a>
      <h1 class="text-4xl font-bold text-text-bright tracking-tight">Model Comparison</h1>
      <p class="text-text-muted mt-3 max-w-2xl leading-relaxed">Put a workload next to a price. See the assumptions, compare the costs and keep a copy of the numbers.</p>
    </header>
    <ModelDataNotice />
    <ModelComparison client:load />
  </div>
</BaseLayout>
