---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RadarFeaturedCard from '../../components/RadarFeaturedCard.astro';
import RadarPickCard from '../../components/RadarPickCard.astro';

import manifest from '../../data/radar/index.json';

// Lazy glob: only the latest day's file is read at build, not the entire
// on-disk archive (which the bot keeps up to MAX_ARCHIVE_DAYS for the horizon bot).
const dayFiles = import.meta.glob('../../data/radar/????-??-??.json');
const latestKey = Object.keys(dayFiles).find((k) => k.includes(manifest.latest));
const dayData = latestKey ? ((await dayFiles[latestKey]()) as any).default : null;

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00Z');
  return d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
}

const archiveDates = manifest.dates.filter((d) => d !== manifest.latest).slice(0, 7);
const olderDate = manifest.dates.length > 1 ? manifest.dates[1] : null;
---

<BaseLayout title="The Radar archive" description="Historical AI product and launch picks, retained with their original dates. No daily feed is running.">
  <div class="max-w-4xl mx-auto px-6 py-16">
    <header class="mb-8">
      <a href="/" class="font-mono text-sm text-text-muted hover:text-neon-cyan transition-colors mb-4 inline-block">&larr; home</a>
      <h1 class="font-mono text-3xl font-bold text-text-bright glow-red">The Radar archive</h1>
      <p class="text-text-muted mt-2">Earlier product discoveries. These records are dated and the daily series has stopped.</p>
      <aside class="mt-5 border-l-2 border-neon-amber bg-neon-amber/5 p-4 text-sm leading-relaxed text-text-muted" aria-label="Historical Radar notice">
        <p>The most recent recorded edition is <time datetime={manifest.latest}>{formatDate(manifest.latest)}</time>. Picks, prices and links have not been rechecked as current recommendations. Products may have changed or disappeared.</p>
        <p class="mt-2">For things you can use now, try the <a href="/tools" class="text-neon-cyan underline underline-offset-4">tested browser tools</a>.</p>
      </aside>
    </header>
    <div class="section-banner mb-6" style="height: 180px; --banner-accent: rgba(218, 94, 116, 0.12); --banner-accent-mid: rgba(218, 94, 116, 0.04)" aria-hidden="true"></div>
    <div class="glow-divider mb-6" style="--divider-color: rgba(218, 94, 116, 0.15)"></div>

    {olderDate && (
      <nav class="flex items-center justify-between mb-10">
        <a href={`/radar/${olderDate}`} class="font-mono text-sm text-text-muted hover:text-neon-red transition-colors flex items-center gap-2 bg-surface border border-surface-light rounded-lg px-4 py-2 hover:border-neon-red/30">
          &larr; {olderDate}
        </a>
        <span class="font-mono text-xs text-neon-red/70">last recorded edition</span>
      </nav>
    )}

    {!dayData ? (
      <div class="bg-surface border border-surface-light rounded-lg p-8 text-center">
        <p class="font-mono text-sm text-text-muted">
          <span class="text-neon-red">&#9679;</span> awaiting first transmission...
        </p>
      </div>
    ) : (
      <div>
        <div class="flex items-center justify-between mb-8">
          <div class="font-mono text-sm text-text-muted">
            <span class="text-neon-red">&#9632;</span>
            <span class="ml-2">{formatDate(dayData.date)}</span>
          </div>
          <span class="font-mono text-xs text-text-muted">
            {dayData.featured.length + dayData.picks.length} products
          </span>
        </div>

        {dayData.featured.length + dayData.picks.length === 0 && (
          <p class="font-mono text-sm text-text-muted py-8 text-center">No picks were recorded for this edition.</p>
        )}

        {dayData.featured.length > 0 && (
          <section class="mb-12">
            <h2 class="font-mono text-xs text-neon-red uppercase tracking-widest mb-6">Featured in this edition</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 ambient-glow" style="--glow-color: rgba(218, 94, 116, 0.035); --glow-color-alt: rgba(90, 184, 212, 0.025)">
              {dayData.featured.map((item: any, index: number) => (
                <RadarFeaturedCard item={item} index={index} />
              ))}
            </div>
          </section>
        )}

        {dayData.picks.length > 0 && (
          <section class="mb-12">
            <h2 class="font-mono text-xs text-neon-red/70 uppercase tracking-widest mb-6">Also on the radar</h2>
            <div class="grid gap-4">
              {dayData.picks.map((item: any, index: number) => (
                <RadarPickCard item={item} index={dayData.featured.length + index} />
              ))}
            </div>
          </section>
        )}

        {dayData.hn_top5 && dayData.hn_top5.length > 0 && (
          <section class="mb-12">
            <h2 class="font-mono text-xs text-neon-amber uppercase tracking-widest mb-6">Hacker News</h2>
            <div class="grid gap-4">
              {dayData.hn_top5.map((story: any, index: number) => (
                <a
                  href={story.hn_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block relative glass-card rounded-xl card-glow card-lift group animate-stagger border-l-2 border-l-neon-amber/40 overflow-hidden"
                  style={`--stagger-index: ${index}`}
                >
                  <div class="p-5 md:p-6">
                    <div class="flex items-start justify-between gap-4">
                      <div class="min-w-0">
                        <div class="flex items-center gap-3 mb-1">
                          <h3 class="font-mono text-base font-bold text-text-bright group-hover:text-neon-amber transition-colors">
                            {story.title}
                          </h3>
                          <span class="shrink-0 px-1.5 py-0.5 rounded text-xs font-mono bg-surface-light text-neon-amber/70">
                            {story.points} pts
                          </span>
                          <span class="shrink-0 px-1.5 py-0.5 rounded text-xs font-mono bg-surface-light text-text-muted">
                            {story.comments} comments
                          </span>
                        </div>
                        <p class="text-sm text-text-muted leading-relaxed">{story.summary}</p>
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        {archiveDates.length > 0 && (
          <nav class="border-t border-surface-light/30 pt-8">
            <h2 class="font-mono text-xs text-text-muted uppercase tracking-widest mb-4">Previous days</h2>
            <div class="flex flex-wrap gap-2">
              {archiveDates.map((d) => (
                <a
                  href={`/radar/${d}`}
                  class="font-mono text-xs px-3 py-1.5 rounded bg-surface border border-surface-light text-text-muted hover:text-neon-red hover:border-neon-red/30 transition-colors"
                >
                  {new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })}
                </a>
              ))}
            </div>
          </nav>
        )}

        <div class="mt-12 text-center">
          <p class="font-mono text-xs text-text-muted/60">
            Historical picks sourced from product reporting and Hacker News. The series is not being updated.
          </p>
        </div>
      </div>
    )}
  </div>
</BaseLayout>
