---
import { SPECIMENS, measureSpecimen, jawBoundary } from '../../content/feral/caliper.mjs';
const first = measureSpecimen(SPECIMENS[0]);
const jaw = jawBoundary(first, 50);
const pct = (value: number | null) => value == null ? 0 : Math.max(0, Math.min(100, value));
const charPosition = (index: number) => first.totalWidth ? first.characters[index].centre / first.totalWidth * 100 : 0;
---
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CALIPER | Feral</title>
    <meta name="description" content="Put one line on the bench. Measure its visible structure and leave its meaning alone." />
    <link rel="canonical" href="https://softcat.ai/feral/caliper/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#specimen-entry">Skip to specimen entry</a>
    <div class="paper">
      <nav aria-label="Feral navigation"><a href="/feral/">Rooms / index</a><span>FERAL INSTRUMENT 012</span><span>CAL / 240</span></nav>
      <header>
        <p class="kicker">Forensic typesetting bench</p>
        <h1>CALIPER</h1>
        <div class="declaration"><p>One line enters.<br />Nothing is inferred.</p><span>Visible structure only.<br />Meaning stays outside.</span></div>
      </header>

      <main>
        <section class="intake" id="specimen-entry" aria-labelledby="intake-title">
          <div class="label-line"><h2 id="intake-title">01 / SUBMIT SPECIMEN</h2><span>Maximum 240 characters</span></div>
          <form id="measure-form">
            <label for="specimen" class="sr-only">One line to measure</label>
            <textarea id="specimen" rows="2" spellcheck="false" disabled>{SPECIMENS[0]}</textarea>
            <div class="form-foot"><output id="length" for="specimen">{first.characters.length} / 240</output><button id="measure" type="submit" disabled>Measure line</button><button id="clear" type="button" disabled>Clear bench</button></div>
          </form>
          <div class="authored" role="group" aria-label="Authored specimens">
            {SPECIMENS.map((specimen, index) => <button type="button" data-specimen={index} disabled><span>0{index + 1}</span>{specimen}</button>)}
          </div>
        </section>

        <section class="instrument" aria-labelledby="bed-title">
          <div class="label-line"><h2 id="bed-title">02 / MEASURING BED</h2><span id="instrument-state">Specimen fixed</span></div>
          <div class="bed-scroll" id="bed-scroll">
            <div class="bed" id="bed" style={`--units:${first.totalWidth}`}>
              <div class="register top" aria-hidden="true">{Array.from({ length: 21 }, (_, i) => <i><b>{i * 5}</b></i>)}</div>
              <div class="echo-field" aria-hidden="true">
                <svg id="echo-arcs" viewBox="0 0 1000 150" preserveAspectRatio="none">
                  {first.echoes.map((echo, index) => {
                    const a = charPosition(echo.first) * 10, b = charPosition(echo.second) * 10;
                    const rise = 28 + index % 4 * 20;
                    return <path d={`M ${a} 145 Q ${(a + b) / 2} ${145 - rise} ${b} 145`} />;
                  })}
                </svg>
                <span id="echo-count">{first.echoes.length} echoes</span>
              </div>
              <div class="specimen-line" id="specimen-line" aria-label={`Measured specimen: ${first.text}`}>
                {first.characters.map(item => <span class={`glyph ${item.className}`} style={`--w:${item.width}`} data-index={item.index}>{item.character === ' ' ? '\u00a0' : item.character}</span>)}
              </div>
              <div class="skyline" id="skyline" aria-label="Character class skyline">
                {first.characters.map(item => <i class={item.className} style={`--w:${item.width}`} title={`Character ${item.index + 1}: ${item.className}`}></i>)}
              </div>
              <div class="pressure" aria-label="Measured positions">
                <i id="balance-mark" class="balance" style={`left:${pct(first.balancePercent)}%`}><b>BALANCE</b></i>
                <i id="vowel-mark" class="vowel" style={`left:${pct(first.vowelCentre)}%`} hidden={first.vowelCentre == null}><b>VOWEL CENTRE</b></i>
                <i id="punctuation-mark" class="punctuation" style={`left:${pct(first.punctuationCentre)}%`} hidden={first.punctuationCentre == null}><b>PUNCTUATION</b></i>
                <div id="vowel-dots">{first.vowels.map(item => <i class="dot vowel-dot" style={`left:${item.position}%`}></i>)}</div>
                <div id="punctuation-dots">{first.punctuation.map(item => <i class="dot punctuation-dot" style={`left:${item.position}%`}></i>)}</div>
              </div>
              <div class="jaw" id="jaw" style={`left:${jaw.position}%`} aria-hidden="true"><i></i><b></b></div>
              <div class="register bottom" aria-hidden="true">{Array.from({ length: 21 }, (_, i) => <i><b>{i * 5}</b></i>)}</div>
            </div>
          </div>

          <div class="jaw-control">
            <label for="jaw-range">CALIPER JAW <span id="jaw-reading">Boundary {jaw.boundary}: “{jaw.left || 'edge'}” / “{jaw.right || 'edge'}”</span></label>
            <input id="jaw-range" type="range" min="0" max="100" step="0.1" value="50" disabled />
          </div>
        </section>

        <section class="readings" aria-labelledby="readings-title">
          <div class="label-line"><h2 id="readings-title">03 / READINGS</h2><span>Calculated locally from this string</span></div>
          <dl>
            <div><dt>Characters</dt><dd id="character-count">{first.characters.length}</dd></div>
            <div><dt>Measured width</dt><dd><span id="width-reading">{first.totalWidth.toFixed(2)}</span> u</dd></div>
            <div><dt>Balance</dt><dd><span id="balance-reading">{first.balancePercent.toFixed(2)}</span>%</dd></div>
            <div><dt>Vowels / centre</dt><dd><span id="vowel-count">{first.vowels.length}</span><small id="vowel-position">{first.vowelCentre?.toFixed(2)}%</small></dd></div>
            <div><dt>Punctuation / pressure</dt><dd><span id="punctuation-count">{first.punctuation.length}</span><small id="punctuation-position">{first.punctuationCentre?.toFixed(2)}%</small></dd></div>
            <div><dt>Echoes</dt><dd id="echo-reading">{first.echoes.length}</dd></div>
          </dl>
          <div class="legend"><span><i class="ascender"></i>Ascender</span><span><i class="x-height"></i>X-height</span><span><i class="descender"></i>Descender</span><span><i class="space"></i>Space</span><span><i class="punctuation"></i>Punctuation</span></div>
          <p class="method">Width is a fixed local table, not font telemetry. Balance treats each character class as a simple constant-height shape of one-density material. Vowel centre and punctuation pressure are mean visible positions. Echoes are repeated two-to-five-character fragments, capped at twelve. These are measurements of this apparatus, not claims about language.</p>
          <p id="notice" class="sr-only" role="status" aria-live="polite">The authored specimen is measured.</p>
        </section>

        <noscript><section class="noscript"><strong>STATIC SPECIMEN / 01</strong><p>{SPECIMENS[0]}</p><span>{first.characters.length} characters · {first.totalWidth.toFixed(2)} units · balance {first.balancePercent.toFixed(2)}% · {first.vowels.length} vowels centred at {first.vowelCentre?.toFixed(2)}% · {first.punctuation.length} punctuation marks pressured at {first.punctuationCentre?.toFixed(2)}% · {first.echoes.length} echoes.</span><p>JavaScript is required to submit another line or move the caliper jaw. The authored specimen and its complete fixed readings remain visible above.</p></section></noscript>
      </main>

      <footer><span>No text is saved, sent or interpreted.</span><a href="/feral/#ledger">Council ledger</a><span>CALIPER / LOCAL APPARATUS</span></footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #d9d2c2; color: #11100d; color-scheme: light; }
  :global(body) { margin: 0; font: 15px/1.45 Arial, Helvetica, sans-serif; }
  :global(button), :global(textarea), :global(input) { font: inherit; }
  :global(button) { color: inherit; cursor: pointer; }
  :global(button:disabled), :global(textarea:disabled), :global(input:disabled) { cursor: default; opacity: .52; }
  :global(:focus-visible) { outline: 3px solid #c81720; outline-offset: 4px; }
  :global([hidden]) { display: none !important; }
  .paper { width: min(1680px, 100%); margin: auto; padding: 0 clamp(1rem, 4vw, 4.5rem); background: #eee9dd; min-height: 100vh; box-shadow: 0 0 80px #4b463c33; }
  .skip { position: absolute; left: 1rem; top: -100px; padding: .8rem 1rem; background: #11100d; color: #fff; z-index: 20; }
  .skip:focus { top: 1rem; }
  nav, footer { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; padding: 1rem 0; border-bottom: 1px solid #11100d; font: 11px/1.3 'Courier New', monospace; letter-spacing: .08em; }
  nav a, footer a { color: inherit; text-underline-offset: 4px; }
  nav span:last-child, footer span:last-child { text-align: right; }
  header { position: relative; padding: clamp(2.2rem, 5vw, 5rem) 0 3rem; border-bottom: 6px double #11100d; }
  .kicker { margin: 0; font: 11px/1.3 'Courier New', monospace; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: .25rem 0 0; font-size: clamp(4.5rem, 15vw, 14rem); line-height: .78; letter-spacing: -.085em; font-weight: 900; }
  .declaration { display: flex; justify-content: flex-end; align-items: flex-end; gap: clamp(2rem, 8vw, 9rem); margin-top: 2rem; }
  .declaration p { margin: 0; font: 600 clamp(1.2rem, 2.5vw, 2.3rem)/1.08 Georgia, serif; }
  .declaration span { font: 11px/1.6 'Courier New', monospace; text-transform: uppercase; }
  main > section { padding: 2rem 0 2.6rem; border-bottom: 1px solid #11100d; }
  .label-line { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; margin-bottom: 1.2rem; font: 11px/1.4 'Courier New', monospace; text-transform: uppercase; letter-spacing: .08em; }
  .label-line h2 { font: inherit; margin: 0; }
  #measure-form { border: 1px solid #11100d; }
  textarea { display: block; width: 100%; resize: vertical; min-height: 92px; padding: 1rem; border: 0; border-bottom: 1px solid #11100d; border-radius: 0; background: #f7f3e9; color: #11100d; font: clamp(1.15rem, 2.6vw, 2.25rem)/1.2 Georgia, serif; }
  .form-foot { display: grid; grid-template-columns: 1fr auto auto; align-items: stretch; font: 11px/1.3 'Courier New', monospace; }
  .form-foot output { padding: .8rem 1rem; align-self: center; }
  .form-foot button { min-height: 44px; padding: .7rem 1rem; border: 0; border-left: 1px solid #11100d; background: transparent; text-transform: uppercase; }
  .form-foot button:hover:not(:disabled) { background: #11100d; color: #f7f3e9; }
  #measure { background: #c81720; color: #fff; }
  .authored { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 1rem; border: 1px solid #11100d; }
  .authored button { display: grid; grid-template-columns: 2rem 1fr; gap: .6rem; min-height: 70px; padding: .8rem; text-align: left; background: transparent; border: 0; border-right: 1px solid #11100d; font: 12px/1.35 'Courier New', monospace; }
  .authored button:last-child { border: 0; }
  .authored button:hover:not(:disabled) { background: #d9d2c2; }
  .authored button span { color: #c81720; }
  .bed-scroll { overflow-x: auto; border: 1px solid #11100d; background: #f7f3e9; scrollbar-color: #11100d #d9d2c2; }
  .bed { --units: 32; position: relative; min-width: max(760px, calc(var(--units) * 15px)); padding: 0 26px; }
  .register { height: 38px; display: grid; grid-template-columns: repeat(21, 1fr); border-color: #777064; font: 8px/1 'Courier New', monospace; }
  .register.top { border-bottom: 1px solid #777064; }
  .register.bottom { border-top: 1px solid #777064; }
  .register i { position: relative; border-left: 1px solid #777064; }
  .register i:last-child { border-right: 1px solid #777064; }
  .register b { position: absolute; left: 2px; font-weight: normal; }
  .register.top b { bottom: 4px; }
  .register.bottom b { top: 4px; }
  .echo-field { height: 155px; position: relative; border-bottom: 1px solid #aaa294; }
  #echo-arcs { width: 100%; height: 150px; display: block; overflow: visible; }
  #echo-arcs path { vector-effect: non-scaling-stroke; stroke: #c81720; stroke-width: 1; fill: none; opacity: .65; }
  #echo-count { position: absolute; right: 4px; top: 4px; font: 9px/1.3 'Courier New', monospace; text-transform: uppercase; }
  .specimen-line, .skyline { display: flex; width: 100%; }
  .specimen-line { min-height: 86px; align-items: flex-end; border-bottom: 2px solid #11100d; padding-top: 14px; }
  .glyph { flex: var(--w) 0 0; min-width: 0; text-align: center; font: clamp(1.1rem, 2vw, 2.2rem)/1 Georgia, serif; overflow: visible; }
  .glyph.space { border-bottom: 3px dotted #aaa294; height: 5px; }
  .glyph.punctuation { color: #c81720; }
  .skyline { height: 76px; align-items: flex-start; border-bottom: 1px solid #aaa294; }
  .skyline i { flex: var(--w) 0 0; background: #11100d; border-right: 1px solid #f7f3e9; }
  .skyline .ascender { height: 62px; }
  .skyline .x-height { height: 41px; }
  .skyline .descender { height: 56px; transform: translateY(16px); }
  .skyline .space { height: 5px; margin-top: 36px; background: #aaa294; }
  .skyline .punctuation { height: 24px; margin-top: 17px; background: #c81720; }
  .pressure { height: 100px; position: relative; border-bottom: 1px solid #aaa294; }
  .pressure > i { position: absolute; top: 0; height: 74px; border-left: 1px solid #11100d; }
  .pressure > i b { position: absolute; top: 77px; left: 3px; white-space: nowrap; font: 8px/1 'Courier New', monospace; font-style: normal; }
  .pressure .balance { border-color: #c81720; border-left-width: 2px; }
  .pressure .balance b { color: #c81720; }
  .pressure .vowel { height: 50px; top: 14px; }
  .pressure .punctuation { height: 34px; top: 30px; border-style: dashed; }
  .dot { position: absolute; top: 15px; width: 4px; height: 4px; border-radius: 50%; background: #11100d; transform: translateX(-2px); }
  .punctuation-dot { top: 31px; background: #c81720; }
  .jaw { position: absolute; top: 30px; bottom: 30px; width: 1px; background: #c81720; z-index: 4; pointer-events: none; }
  .jaw > i, .jaw > b { position: absolute; left: -9px; width: 19px; height: 10px; border: 2px solid #c81720; background: #f7f3e9; }
  .jaw > i { top: 0; border-bottom: 0; }
  .jaw > b { bottom: 0; border-top: 0; }
  .jaw-control { display: grid; grid-template-columns: minmax(15rem, .35fr) 1fr; gap: 1rem; align-items: center; border: 1px solid #11100d; border-top: 0; padding: .8rem 1rem; font: 10px/1.4 'Courier New', monospace; }
  .jaw-control label { display: flex; justify-content: space-between; gap: 1rem; }
  #jaw-reading { color: #c81720; }
  input[type="range"] { width: 100%; accent-color: #c81720; }
  .readings dl { display: grid; grid-template-columns: repeat(6, 1fr); margin: 0; border: 1px solid #11100d; }
  .readings dl div { padding: 1rem; border-right: 1px solid #11100d; }
  .readings dl div:last-child { border: 0; }
  .readings dt { font: 9px/1.3 'Courier New', monospace; text-transform: uppercase; }
  .readings dd { margin: .35rem 0 0; font: 600 clamp(1.5rem, 3vw, 3.2rem)/1 Georgia, serif; font-variant-numeric: tabular-nums; }
  .readings dd small { display: block; margin-top: .35rem; font: 9px/1.2 'Courier New', monospace; color: #c81720; }
  .legend { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1rem; font: 9px/1.3 'Courier New', monospace; text-transform: uppercase; }
  .legend span { display: flex; align-items: center; gap: .4rem; }
  .legend i { width: 13px; height: 13px; display: inline-block; background: #11100d; }
  .legend i.descender { transform: translateY(3px); }
  .legend i.space { height: 2px; background: #777064; }
  .legend i.punctuation { background: #c81720; }
  .method { max-width: 88ch; margin: 1.5rem 0 0; font: 11px/1.6 'Courier New', monospace; }
  .noscript { margin: 1.5rem 0; padding: 1rem; border: 2px solid #c81720; font: 11px/1.55 'Courier New', monospace; }
  .noscript p { margin: .6rem 0; }
  footer { border: 0; border-top: 1px solid #11100d; padding: 1.3rem 0 2rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 800px) {
    nav { grid-template-columns: 1fr auto; }
    nav span:last-child { display: none; }
    .declaration { justify-content: space-between; }
    .authored { grid-template-columns: 1fr; }
    .authored button { border-right: 0; border-bottom: 1px solid #11100d; }
    .jaw-control { grid-template-columns: 1fr; }
    .readings dl { grid-template-columns: repeat(3, 1fr); }
    .readings dl div { border-bottom: 1px solid #11100d; }
    .readings dl div:nth-child(3) { border-right: 0; }
    .readings dl div:nth-child(n+4) { border-bottom: 0; }
  }
  @media (max-width: 480px) {
    .paper { padding-inline: .75rem; }
    header { padding-top: 2.5rem; }
    h1 { font-size: 23vw; }
    .declaration { display: block; }
    .declaration span { display: block; margin-top: 1rem; }
    .form-foot { grid-template-columns: 1fr 1fr; }
    .form-foot output { grid-column: 1 / -1; border-bottom: 1px solid #11100d; }
    .form-foot button:first-of-type { border-left: 0; }
    .readings dl { grid-template-columns: repeat(2, 1fr); }
    .readings dl div:nth-child(odd) { border-right: 1px solid #11100d; }
    .readings dl div:nth-child(even) { border-right: 0; }
    .readings dl div:nth-child(n+5) { border-bottom: 0; }
    footer { grid-template-columns: 1fr 1fr; }
    footer span:last-child { grid-column: 1 / -1; text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) { :global(*) { scroll-behavior: auto !important; } }
</style>

<script>
  import { MAX_SPECIMEN, SPECIMENS, clampSpecimen, measureSpecimen, jawBoundary } from '../../content/feral/caliper.mjs';
  const get = (id: string) => document.getElementById(id)!;
  const input = get('specimen') as HTMLTextAreaElement;
  const jawRange = get('jaw-range') as HTMLInputElement;
  const svgNS = 'http://www.w3.org/2000/svg';
  let report = measureSpecimen(input.value);
  const safeText = (character: string) => character === ' ' ? '\u00a0' : character;
  function marker(id: string, value: number | null) {
    const node = get(id) as HTMLElement;
    node.hidden = value == null;
    if (value != null) node.style.left = `${Math.max(0, Math.min(100, value))}%`;
  }
  function dot(className: string, position: number) {
    const node = document.createElement('i'); node.className = `dot ${className}`; node.style.left = `${position}%`; return node;
  }
  function renderJaw() {
    const reading = jawBoundary(report, Number(jawRange.value));
    get('jaw').hidden = !report.characters.length;
    get('jaw').style.left = `${reading.position}%`;
    get('jaw-reading').textContent = `Boundary ${reading.boundary}: “${reading.left || 'edge'}” / “${reading.right || 'edge'}”`;
  }
  function render(announce = true) {
    get('bed').style.setProperty('--units', String(Math.max(1, report.totalWidth)));
    get('specimen-line').replaceChildren(...report.characters.map(item => {
      const node = document.createElement('span'); node.className = `glyph ${item.className}`; node.style.setProperty('--w', String(item.width)); node.dataset.index = String(item.index); node.textContent = safeText(item.character); return node;
    }));
    get('specimen-line').setAttribute('aria-label', `Measured specimen: ${report.text || 'empty bench'}`);
    get('skyline').replaceChildren(...report.characters.map(item => {
      const node = document.createElement('i'); node.className = item.className; node.style.setProperty('--w', String(item.width)); node.title = `Character ${item.index + 1}: ${item.className}`; return node;
    }));
    const arcs = get('echo-arcs'); arcs.replaceChildren(...report.echoes.map((echo, index) => {
      const a = report.totalWidth ? report.characters[echo.first].centre / report.totalWidth * 1000 : 0;
      const b = report.totalWidth ? report.characters[echo.second].centre / report.totalWidth * 1000 : 0;
      const path = document.createElementNS(svgNS, 'path'); const rise = 28 + index % 4 * 20;
      path.setAttribute('d', `M ${a} 145 Q ${(a + b) / 2} ${145 - rise} ${b} 145`); return path;
    }));
    get('echo-count').textContent = `${report.echoes.length} echoes`;
    marker('balance-mark', report.characters.length ? report.balancePercent : null);
    marker('vowel-mark', report.vowelCentre);
    marker('punctuation-mark', report.punctuationCentre);
    get('vowel-dots').replaceChildren(...report.vowels.map(item => dot('vowel-dot', item.position)));
    get('punctuation-dots').replaceChildren(...report.punctuation.map(item => dot('punctuation-dot', item.position)));
    get('character-count').textContent = String(report.characters.length);
    get('width-reading').textContent = report.totalWidth.toFixed(2);
    get('balance-reading').textContent = report.balancePercent.toFixed(2);
    get('vowel-count').textContent = String(report.vowels.length);
    get('punctuation-count').textContent = String(report.punctuation.length);
    get('vowel-position').textContent = report.vowelCentre == null ? 'none' : `${report.vowelCentre.toFixed(2)}%`;
    get('punctuation-position').textContent = report.punctuationCentre == null ? 'none' : `${report.punctuationCentre.toFixed(2)}%`;
    get('echo-reading').textContent = String(report.echoes.length);
    get('instrument-state').textContent = report.characters.length ? 'Specimen fixed' : 'Bench empty';
    jawRange.disabled = !report.characters.length;
    renderJaw();
    if (announce) get('notice').textContent = report.characters.length ? `Measured ${report.characters.length} characters. Balance point ${report.balancePercent.toFixed(2)} per cent.` : 'The measuring bench is clear.';
  }
  function measure(value: string) {
    input.value = clampSpecimen(value); report = measureSpecimen(input.value); get('length').textContent = `${report.characters.length} / ${MAX_SPECIMEN}`; render();
  }
  input.disabled = false; get('measure').removeAttribute('disabled'); get('clear').removeAttribute('disabled'); jawRange.disabled = false;
  document.querySelectorAll<HTMLButtonElement>('[data-specimen]').forEach(button => { button.disabled = false; button.addEventListener('click', () => { const index = Number(button.dataset.specimen); input.value = SPECIMENS[index]; measure(input.value); input.focus(); }); });
  input.addEventListener('input', () => { const clean = clampSpecimen(input.value); if (clean !== input.value) input.value = clean; get('length').textContent = `${Array.from(clean).length} / ${MAX_SPECIMEN}`; });
  get('measure-form').addEventListener('submit', event => { event.preventDefault(); measure(input.value); });
  get('clear').addEventListener('click', () => { input.value = ''; jawRange.value = '50'; measure(''); input.focus(); });
  jawRange.addEventListener('input', renderJaw);
</script>
