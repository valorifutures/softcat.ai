---
import { BOARD, KNOTS, inspect } from '../../content/feral/snarl.mjs';
const first = KNOTS[0];
const report = inspect(first.initial, first.edges);
const nodeSlots = Array.from({ length: 10 }, (_, index) => index);
const cordSlots = Array.from({ length: 15 }, (_, index) => index);
---
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SNARL | Feral</title>
    <meta name="description" content="Three small knots. Move the eyelets until the cords stop getting in each other's way. A local, finite cord puzzle." />
    <link rel="canonical" href="https://softcat.ai/feral/snarl/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#hands">Skip to the eyelet controls</a>
    <div class="sheet">
      <nav aria-label="Feral navigation"><a href="/feral/">The other rooms</a><span>Feral / 011</span></nav>
      <header><h1>SNARL</h1><div><p>Put this mess<br />in its place.</p><span>Move the eyelets.<br />Uncross the cords.</span></div></header>
      <main>
        <div class="knots" role="group" aria-label="Choose a knot">
          {KNOTS.map((knot, index) => <button type="button" data-knot={index} aria-pressed={index === 0 ? 'true' : 'false'} disabled><span class="knot-number">0{index + 1}</span><span><strong>{knot.name}</strong><small>{knot.initial.length} eyelets <span class="knot-state">Not cleared</span></small></span></button>)}
        </div>
        <div class="workbench">
          <section class="work" aria-label="Cord field">
            <div class="field-label"><span id="knot-name">{first.name}</span><span>A flat geometry game</span></div>
            <svg id="board" viewBox={`0 0 ${BOARD.width} ${BOARD.height}`} role="group" aria-label="Interactive cord field" aria-describedby="board-help selected-position">
              <g id="cords" aria-hidden="true">
                {cordSlots.map(index => {
                  const edge = first.edges[index];
                  const a = edge ? first.initial[edge[0]] : { x: 0, y: 0 };
                  const b = edge ? first.initial[edge[1]] : { x: 0, y: 0 };
                  return <line data-cord={index} x1={a.x} y1={a.y} x2={b.x} y2={b.y} hidden={!edge} />;
                })}
              </g>
              <g id="eyelets">
                {nodeSlots.map(index => {
                  const point = first.initial[index] ?? { x: 0, y: 0 };
                  return <g class="eyelet" data-eyelet={index} transform={`translate(${point.x} ${point.y})`} role="button" tabindex="-1" aria-label={`Eyelet ${index + 1}`} aria-disabled="true" aria-pressed={index === 0 ? 'true' : 'false'} hidden={index >= first.initial.length}>
                    <circle class="hit" r="30" />
                    <circle class="selection" r="29" />
                    <circle class="rim" r="22" />
                    <circle class="hole" r="12" />
                    <text y=".35em" text-anchor="middle" aria-hidden="true">{index + 1}</text>
                  </g>;
                })}
              </g>
            </svg>
            <div class="reading"><p><output id="snag-count">{report.total}</output><span>snags remaining</span></p><p id="result">Take your time.</p></div>
            <dl class="counts"><div><dt>Cord pairs</dt><dd id="cord-count">{report.cordPairs.length}</dd></div><div><dt>Crowded eyelets</dt><dd id="close-count">{report.closeEyelets.length}</dd></div><div><dt>Eyelet / cord</dt><dd id="blocked-count">{report.blockedEyelets.length}</dd></div></dl>
            <p id="board-help" class="help">Drag an eyelet. Or focus one and use the arrow keys: 5 units at a time, 20 with Shift. Cords may meet at their shared eyelets.</p>
            <details class="rules"><summary>What counts as a snag?</summary><p>A pair of crossing or overlapping cords, a pair of eyelets too close together, or an eyelet touching an unrelated cord. One crowded place can contain several snags. Moving everything into one heap will not clear it.</p></details>
          </section>
          <section class="hands" id="hands" aria-label="Eyelet controls">
            <p class="eyebrow">A little room, please</p>
            <form id="position-form" novalidate>
              <label for="eyelet">Choose an eyelet</label>
              <select id="eyelet" disabled>{first.initial.map((_, index) => <option value={index}>Eyelet {index + 1}</option>)}</select>
              <div class="coordinates"><label for="across">Across<input id="across" type="number" min={BOARD.inset} max={BOARD.width - BOARD.inset} step="1" value={first.initial[0].x} required disabled /></label><label for="down">Down<input id="down" type="number" min={BOARD.inset} max={BOARD.height - BOARD.inset} step="1" value={first.initial[0].y} required disabled /></label></div>
              <button class="move" type="submit" disabled>Move this eyelet <span aria-hidden="true">↗</span></button>
            </form>
            <p id="selected-position" class="position">Eyelet 1 selected. Across {first.initial[0].x}, down {first.initial[0].y}.</p>
            <button id="reset" type="button" disabled>Reset this knot <span aria-hidden="true">↺</span></button>
            <button id="reveal" type="button" disabled>Show an untangled arrangement</button>
            <p class="reveal-note">Shown knots stay marked as shown for this visit, including after reset.</p>
            <p id="shown-note" class="shown-note" hidden>Arrangement shown. This knot will not count as cleared by hand during this visit.</p>
            <p id="notice" class="sr-only" role="status" aria-atomic="true">The first knot has {report.total} snags.</p>
          </section>
        </div>
        <p class="leaving" id="leaving">A small repair.<br /><span>No need to hurry.</span></p>
        <noscript><p class="no-script">The first knot is shown above. JavaScript is needed to move the eyelets or choose another knot; the controls are inactive.</p></noscript>
      </main>
      <footer><span>Original cords. No board state is saved or sent.</span><a href="/feral/#ledger">The council's record</a></footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { color-scheme: dark; background: #37243e; color: #f7efd9; }
  :global(body) { margin: 0; font: .875rem/1.5 system-ui, sans-serif; }
  :global(a) { color: inherit; text-underline-offset: 4px; }
  :global(button), :global(input), :global(select) { font: inherit; }
  :global(button) { cursor: pointer; touch-action: manipulation; }
  :global(button:disabled), :global(input:disabled), :global(select:disabled) { opacity: .45; cursor: default; }
  :global(:focus-visible) { outline: 3px solid #ff9557; outline-offset: 4px; }
  :global([hidden]) { display: none !important; }
  .sheet { max-width: 1600px; padding: 0 clamp(1rem, 4vw, 4rem); margin: auto; }
  .skip { position: absolute; top: -100px; left: 1rem; padding: .75rem 1rem; background: #f7efd9; color: #37243e; z-index: 10; }
  .skip:focus { top: 1rem; }
  nav, footer { display: flex; justify-content: space-between; gap: .75rem; flex-wrap: wrap; font: .68rem/1.5 ui-monospace, monospace; }
  nav { padding: 1.2rem 0; border-bottom: 1px solid #806b83; }
  nav a { text-decoration: none; }
  header { display: flex; justify-content: space-between; gap: 2rem; align-items: flex-end; padding: 2.8rem 0 2.6rem; }
  h1 { font-size: clamp(5rem, 14vw, 13rem); font-weight: 950; letter-spacing: -.08em; line-height: .78; margin: 0; }
  header > div { display: flex; gap: clamp(1.5rem, 4vw, 4rem); align-items: flex-end; }
  header p { font-size: clamp(1.5rem, 3vw, 2.8rem); letter-spacing: -.04em; line-height: 1.07; margin: 0; }
  header span { font: .72rem/1.7 ui-monospace, monospace; }
  .knots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .7rem; margin-bottom: 2rem; }
  .knots button { display: flex; align-items: center; text-align: left; gap: 1rem; border: 1px solid #806b83; background: transparent; color: #f7efd9; padding: .8rem 1rem; min-height: 78px; }
  .knots button[aria-pressed="true"] { background: #4b3153; border-color: #f7efd9; }
  .knots button:hover:not(:disabled) { background: #4b3153; }
  .knot-number { color: #ff9557; font: 1.6rem/1 ui-monospace, monospace; letter-spacing: -.06em; }
  .knots strong { display: block; font-size: .9rem; font-weight: 650; }
  .knots small { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: .2rem; font: .62rem/1.5 ui-monospace, monospace; color: #dbcbdb; }
  .knot-state { color: #f7efd9; }
  .workbench { display: grid; grid-template-columns: minmax(0, 1fr) 248px; gap: clamp(1.25rem, 3vw, 3rem); align-items: start; }
  .work { min-width: 0; }
  .field-label { display: flex; justify-content: space-between; gap: .5rem; padding: .6rem 0; border-top: 1px solid #806b83; font: .65rem/1.5 ui-monospace, monospace; color: #dbcbdb; }
  #board { display: block; width: 100%; height: auto; background: #452c4e; border: 1px solid #806b83; touch-action: none; user-select: none; }
  #cords line { stroke: #ff9557; stroke-width: 8; stroke-linecap: round; pointer-events: none; }
  #cords line.tangled { stroke: #ffae70; }
  .eyelet { cursor: grab; }
  .eyelet:active { cursor: grabbing; }
  .eyelet .hit { fill: transparent; pointer-events: all; }
  .eyelet .selection { fill: none; stroke: #ff9557; stroke-width: 2; opacity: 0; pointer-events: none; }
  .eyelet[aria-pressed="true"] .selection { opacity: 1; }
  .eyelet .rim { fill: #f7efd9; stroke: #37243e; stroke-width: 3; }
  .eyelet .hole { fill: #37243e; pointer-events: none; }
  .eyelet text { fill: #f7efd9; font: 12px ui-monospace, monospace; pointer-events: none; }
  .eyelet:focus-visible { outline: none; }
  .eyelet:focus-visible .selection { opacity: 1; stroke: #f7efd9; stroke-width: 4; }
  .reading { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-end; margin-top: .9rem; }
  .reading p { margin: 0; }
  #snag-count { display: block; font: 750 clamp(2.8rem, 5vw, 5rem)/1 system-ui, sans-serif; letter-spacing: -.07em; font-variant-numeric: tabular-nums; }
  .reading p > span { font: .65rem/1.7 ui-monospace, monospace; color: #dbcbdb; }
  #result { font-size: 1rem; color: #ffae70; text-align: right; max-width: 25ch; }
  .counts { display: flex; gap: 1.4rem; flex-wrap: wrap; margin: 1rem 0 0; padding-top: .75rem; border-top: 1px solid #806b83; }
  .counts div { display: flex; gap: .5rem; font: .62rem/1.5 ui-monospace, monospace; }
  .counts dt { color: #dbcbdb; }
  .counts dd { margin: 0; }
  .help { font-size: .73rem; margin: 1rem 0 0; max-width: 65em; color: #dbcbdb; }
  .rules { margin-top: .8rem; font-size: .72rem; }
  .rules summary { cursor: pointer; }
  .rules p { max-width: 68em; color: #dbcbdb; }
  .hands { padding-top: .55rem; }
  .eyebrow { font: .65rem/1.5 ui-monospace, monospace; margin: 0 0 1rem; color: #dbcbdb; }
  .hands label { display: block; font: .67rem/1.5 ui-monospace, monospace; }
  .hands select, .hands input { width: 100%; min-width: 0; min-height: 44px; display: block; background: #452c4e; color: #f7efd9; border: 1px solid #b19ab0; border-radius: 0; padding: .6rem .7rem; margin-top: .35rem; font: .85rem/1.5 ui-monospace, monospace; }
  .coordinates { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: .65rem; margin-top: 1rem; }
  .hands button { width: 100%; min-height: 46px; display: flex; justify-content: space-between; gap: .5rem; text-align: left; color: #f7efd9; background: transparent; border: 1px solid #b19ab0; padding: .7rem .8rem; font-size: .8rem; }
  .hands button:hover:not(:disabled) { background: #4b3153; border-color: #f7efd9; }
  .hands .move { margin-top: .8rem; background: #ff9557; color: #37243e; border-color: #ff9557; font-weight: 650; }
  .hands .move:hover:not(:disabled) { background: #ffae70; border-color: #ffae70; }
  .position { font: .65rem/1.6 ui-monospace, monospace; color: #dbcbdb; margin: .8rem 0 1.5rem; }
  #reveal { margin-top: .65rem; }
  .reveal-note, .shown-note { font-size: .7rem; margin: .75rem 0 0; color: #dbcbdb; }
  .shown-note { border-left: 2px solid #ff9557; padding-left: .7rem; color: #f7efd9; }
  .leaving { margin: 2.5rem 0; font-size: clamp(1.8rem, 4vw, 4rem); line-height: 1.1; letter-spacing: -.045em; }
  .leaving span { color: #ffae70; }
  footer { border-top: 1px solid #806b83; padding: 1.25rem 0 1.8rem; color: #dbcbdb; }
  .no-script { border: 1px solid #ff9557; padding: 1rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 1000px) {
    header > div { display: block; }
    header span { display: block; margin-top: .8rem; }
    .workbench { grid-template-columns: minmax(0, 1fr) 220px; gap: 1.2rem; }
  }
  @media (max-width: 700px) {
    header { display: block; padding: 2rem 0; }
    h1 { font-size: clamp(5rem, 20vw, 8rem); }
    header > div { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.6rem; }
    header p { font-size: clamp(1.3rem, 5vw, 2rem); }
    header span { margin: 0; font-size: .63rem; }
    .knots { gap: .4rem; margin-bottom: 1.5rem; }
    .knots button { display: block; padding: .65rem .55rem; }
    .knot-number { display: block; font-size: 1.1rem; margin-bottom: .45rem; }
    .knots strong { font-size: .73rem; line-height: 1.3; min-height: 2.6em; }
    .knots small { display: block; font-size: .56rem; }
    .knot-state { display: block; margin-top: .2rem; }
    .workbench { grid-template-columns: 1fr; gap: 1.5rem; }
    .hands { max-width: none; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: .8rem; }
    .eyebrow, #position-form, .position, .reveal-note, .shown-note { grid-column: 1 / -1; }
    .eyebrow, .position { margin: 0; }
    #reveal { margin: 0; }
    .hands button { font-size: .73rem; }
    .counts { gap: .6rem 1rem; }
    .counts div { font-size: .57rem; }
    .reading { align-items: center; }
    #result { font-size: .85rem; }
    .leaving { margin: 2rem 0; }
  }
</style>

<script>
  import { BOARD, KNOTS, createGame, chooseKnot, selectEyelet, moveEyelet, resetKnot, showArrangement, progress } from '../../content/feral/snarl.mjs';
  const get = (id: string) => document.getElementById(id)!;
  const board = get('board') as unknown as SVGSVGElement;
  const picker = get('eyelet') as HTMLSelectElement;
  const across = get('across') as HTMLInputElement;
  const down = get('down') as HTMLInputElement;
  const knots = [...document.querySelectorAll<HTMLButtonElement>('[data-knot]')];
  const cords = [...document.querySelectorAll<SVGLineElement>('[data-cord]')];
  const eyelets = [...document.querySelectorAll<SVGGElement>('[data-eyelet]')];
  const game = createGame();
  let drag: { id: number; index: number; x: number; y: number } | null = null;
  function say(text: string) { if (get('notice').textContent !== text) get('notice').textContent = text; }
  function render(announce = true) {
    const state = game.knots[game.current];
    const definition = KNOTS[game.current];
    const whole = progress(game);
    const report = whole.reports[game.current];
    const tangled = new Set(report.cordPairs.flatMap(pair => [pair.first, pair.second]));
    cords.forEach((line, index) => {
      const edge = definition.edges[index];
      if (!edge) { line.setAttribute('hidden', ''); return; }
      line.removeAttribute('hidden');
      const a = state.points[edge[0]], b = state.points[edge[1]];
      line.setAttribute('x1', String(a.x)); line.setAttribute('y1', String(a.y));
      line.setAttribute('x2', String(b.x)); line.setAttribute('y2', String(b.y));
      line.classList.toggle('tangled', tangled.has(index));
    });
    eyelets.forEach((eyelet, index) => {
      const point = state.points[index];
      if (!point) { eyelet.setAttribute('hidden', ''); eyelet.setAttribute('tabindex', '-1'); return; }
      eyelet.removeAttribute('hidden'); eyelet.setAttribute('tabindex', '0'); eyelet.setAttribute('aria-disabled', 'false');
      eyelet.setAttribute('transform', `translate(${point.x} ${point.y})`);
      eyelet.setAttribute('aria-pressed', String(index === state.selected));
      eyelet.setAttribute('aria-label', `Eyelet ${index + 1}, across ${point.x}, down ${point.y}. Arrow keys move this eyelet.`);
    });
    if (picker.options.length !== state.points.length) picker.replaceChildren(...state.points.map((_, index) => new Option(`Eyelet ${index + 1}`, String(index))));
    picker.value = String(state.selected);
    const point = state.points[state.selected];
    across.value = String(point.x); down.value = String(point.y);
    across.removeAttribute('aria-invalid'); down.removeAttribute('aria-invalid');
    get('selected-position').textContent = `Eyelet ${state.selected + 1} selected. Across ${point.x}, down ${point.y}.`;
    get('knot-name').textContent = definition.name;
    get('snag-count').textContent = String(report.total);
    get('cord-count').textContent = String(report.cordPairs.length);
    get('close-count').textContent = String(report.closeEyelets.length);
    get('blocked-count').textContent = String(report.blockedEyelets.length);
    knots.forEach((button, index) => {
      button.setAttribute('aria-pressed', String(index === game.current));
      button.querySelector('.knot-state')!.textContent = game.knots[index].shown ? 'Shown' : whole.byHand[index] ? 'Cleared by hand' : 'Not cleared';
    });
    const text = report.clear ? state.shown ? 'Arrangement shown.' : 'This one can breathe.' : state.shown ? 'This knot was shown earlier.' : 'Take your time.';
    get('result').textContent = text;
    get('shown-note').hidden = !state.shown;
    get('leaving').textContent = whole.allByHand ? 'There. Now you can leave it alone.' : 'A small repair. No need to hurry.';
    if (announce) say(`${definition.name}. ${report.total} snags remaining. ${whole.allByHand ? 'There. Now you can leave it alone.' : text}`);
    return report;
  }
  function point(event: PointerEvent) {
    const box = board.getBoundingClientRect();
    if (box.width <= 0 || box.height <= 0) return null;
    const x = (event.clientX - box.left) / box.width * BOARD.width;
    const y = (event.clientY - box.top) / box.height * BOARD.height;
    return Number.isFinite(x) && Number.isFinite(y) ? { x, y } : null;
  }
  function stopDrag() {
    if (!drag) return;
    const id = drag.id; drag = null;
    if (board.hasPointerCapture(id)) board.releasePointerCapture(id);
  }
  function finish(event: PointerEvent) {
    if (!drag || event.pointerId !== drag.id) return;
    const at = point(event);
    if (event.type === 'pointerup' && at) moveEyelet(game, drag.index, at.x - drag.x, at.y - drag.y);
    stopDrag(); render();
  }
  knots.forEach((button, index) => {
    button.disabled = false;
    button.addEventListener('click', () => { stopDrag(); chooseKnot(game, index); render(); });
  });
  [picker, across, down].forEach(input => { input.disabled = false; });
  document.querySelectorAll<HTMLButtonElement>('.hands button').forEach(button => { button.disabled = false; });
  picker.addEventListener('change', () => { stopDrag(); selectEyelet(game, Number(picker.value)); render(); });
  get('position-form').addEventListener('submit', event => {
    event.preventDefault(); stopDrag();
    const x = across.valueAsNumber, y = down.valueAsNumber;
    across.setAttribute('aria-invalid', String(!Number.isFinite(x)));
    down.setAttribute('aria-invalid', String(!Number.isFinite(y)));
    if (!Number.isFinite(x) || !Number.isFinite(y)) { say('Give the eyelet two numbers first. The cords have not moved.'); return; }
    moveEyelet(game, game.knots[game.current].selected, x, y);
    const report = render();
    if (!report.clear && (Number(across.value) !== x || Number(down.value) !== y)) say('The eyelet stays inside the field. Its position has been bounded.');
  });
  get('reset').addEventListener('click', () => { stopDrag(); resetKnot(game); across.removeAttribute('aria-invalid'); down.removeAttribute('aria-invalid'); render(); });
  get('reveal').addEventListener('click', () => { stopDrag(); showArrangement(game); render(); });
  eyelets.forEach((eyelet, index) => {
    eyelet.addEventListener('focus', () => { selectEyelet(game, index); render(false); });
    eyelet.addEventListener('keydown', event => {
      const movements = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectEyelet(game, index); render(); return; }
      const movement = movements[event.key as keyof typeof movements];
      if (!movement) return;
      event.preventDefault(); stopDrag(); selectEyelet(game, index);
      const current = game.knots[game.current].points[index];
      const amount = event.shiftKey ? 20 : 5;
      moveEyelet(game, index, current.x + movement[0] * amount, current.y + movement[1] * amount); render();
    });
    eyelet.addEventListener('pointerdown', event => {
      if (drag || event.pointerType === 'mouse' && event.button !== 0) return;
      const at = point(event); if (!at) return;
      event.preventDefault(); selectEyelet(game, index);
      const current = game.knots[game.current].points[index];
      drag = { id: event.pointerId, index, x: at.x - current.x, y: at.y - current.y };
      eyelet.focus({ preventScroll: true }); board.setPointerCapture(event.pointerId); render(false);
    });
  });
  board.addEventListener('pointermove', event => {
    if (!drag || event.pointerId !== drag.id) return;
    const at = point(event); if (!at) return;
    moveEyelet(game, drag.index, at.x - drag.x, at.y - drag.y); render(false);
  });
  ['pointerup', 'pointercancel', 'lostpointercapture'].forEach(name => board.addEventListener(name, event => finish(event as PointerEvent)));
  document.addEventListener('visibilitychange', () => { if (document.hidden) stopDrag(); });
  window.addEventListener('pagehide', stopDrag);
  render(false);
</script>
