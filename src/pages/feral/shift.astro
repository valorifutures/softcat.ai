      </div>

      <div class="slip" id="slip" hidden>
        <h2>SHIFT DOCKET</h2>
        <div class="rule"></div>
        <dl>
          <dt>SHIFT</dt><dd id="dShift">1</dd>
          <dt>DURATION</dt><dd id="dDur">00:00</dd>
          <dt>UNITS</dt><dd id="dUnits">0</dd>
          <dt>QUOTA</dt><dd id="dQuota">0</dd>
          <dt>LOSS VENTED</dt><dd id="dLoss">0</dd>
          <dt>FAULTS LOGGED</dt><dd id="dFaults">0</dd>
          <dt>TERMINATION</dt><dd id="dEnd">CLOCK</dd>
        </dl>
        <div class="rule"></div>
        <p class="assess" id="dAssess">OUTPUT WITHIN TOLERANCE.</p>
        <p class="prod">PRODUCT: &mdash;</p>
        <p class="foot">UNIT 4 / CLASS B / NO SERVICEABLE PARTS INSIDE</p>
        <button id="nextBtn" type="button">BEGIN NEXT SHIFT</button>
      </div>
    </div>

    <script type="module" is:inline>
      "use strict";

      /* =====================================================================
         TUNING. All rates are per second. dt is clamped, so a backgrounded
         tab cannot rupture the unit.
         ===================================================================== */
      const SHIFT_SECONDS = 90;
      const OUTPUT_PER_FEED = 0.09;   // feed 100 -> 9 units/s
      const PRESS_NEUTRAL = 35;       // feed below this bleeds pressure off
      const PRESS_GAIN = 0.28;        // feed 100 -> +18.2/s
      const VENT_RATE = 26;
      const TEMP_FEED = 0.1;
      const TEMP_KNEE = 55;           // pressure above this cooks the unit
      const TEMP_KNEE_GAIN = 0.3;
      const TEMP_AMBIENT = 1.6;
      const TEMP_LEAK = 0.032;
      const COOL_RATE = 14;
      const COOL_DRAIN = 16;          // ~6.2s of coolant from full
      const COOL_REFILL = 4.5;        // ~22s to refill, and only under feed 40
      const COOL_FEED_MAX = 40;
      const LOSS_PER_SEC = 4.5;
      const PIN_LIMIT = 3;            // seconds at maximum before failure
      const RED_AT = 80;
      const FAULT_MIN = 11;
      const FAULT_MAX = 19;
      const RESET_HOLD = 2;
      const STORE_KEY = "feral.shift.best";

      const quotaFor = (n) => 320 + 58 * (n - 1) + 4 * (n - 1) * (n - 1);

      const SYS = {
        feed: { label: "FEED GOVERNOR", lamp: "lampFeed" },
        vent: { label: "VENT SOLENOID", lamp: "lampVent" },
        cool: { label: "COOLANT PUMP", lamp: "lampCool" }
      };
      const SYS_KEYS = Object.keys(SYS);

      const ASSESS = {
        tolerance: "OUTPUT WITHIN TOLERANCE.",
        short: "QUOTA NOT MET. NO ACTION REQUIRED.",
        survived: "UNIT SURVIVED.",
        present: "OPERATOR PRESENT FOR FULL SHIFT.",
        ruptured: "RUPTURE LOGGED. UNIT REPLACED."
      };

      const reduceMotion =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const $ = (id) => document.getElementById(id);
      const clamp = (v, lo, hi) => (v < lo ? lo : v > hi ? hi : v);
      const pad = (n, w) => String(Math.max(0, Math.floor(n))).padStart(w, "0");
      const mmss = (s) => {
        const t = Math.max(0, Math.ceil(s));
        return pad(Math.floor(t / 60), 2) + ":" + pad(t % 60, 2);
      };

      /* =====================================================================
         SOUND. Nothing is constructed until the SOUND switch is thrown.
         Master gain is zero until then and returns to zero when switched off.
         ===================================================================== */
      const snd = {
        ctx: null,
        on: false,
        ready: false,
        master: null,
        hum: null, humGain: null,
        over: null, overGain: null,
        chug: null, chugLfo: null, chugDepth: null,
        vent: null, ventGain: null, ventFilt: null,
        alarmA: null, alarmB: null, alarmGainA: null, alarmGainB: null,
        noise: null,
        flip: false,
        flipAt: 0,
        dead: false
      };

      function makeNoise(ctx) {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
        return buf;
      }

      function buildAudio() {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return false;
        const ctx = new AC();
        snd.ctx = ctx;
        snd.noise = makeNoise(ctx);

        const master = ctx.createGain();
        master.gain.value = 0;
        master.connect(ctx.destination);
        snd.master = master;

        // base hum: 55Hz through a lowpass that opens with feed
        const humFilt = ctx.createBiquadFilter();
        humFilt.type = "lowpass";
        humFilt.frequency.value = 220;
        humFilt.Q.value = 3;

        const hum = ctx.createOscillator();
        hum.type = "triangle";
        hum.frequency.value = 55;
        const humGain = ctx.createGain();
        humGain.gain.value = 0.0001;

        // the chug: an amplitude LFO whose rate tracks feed
        const chug = ctx.createGain();
        chug.gain.value = 0.62;
        const chugLfo = ctx.createOscillator();
        chugLfo.type = "sine";
        chugLfo.frequency.value = 2;
        const chugDepth = ctx.createGain();
        chugDepth.gain.value = 0.34;
        chugLfo.connect(chugDepth).connect(chug.gain);

        hum.connect(humFilt).connect(humGain).connect(chug).connect(master);

        // the octave above swells with pressure
        const over = ctx.createOscillator();
        over.type = "sawtooth";
        over.frequency.value = 110;
        const overFilt = ctx.createBiquadFilter();
        overFilt.type = "lowpass";
        overFilt.frequency.value = 900;
        const overGain = ctx.createGain();
        overGain.gain.value = 0.0001;
        over.connect(overFilt).connect(overGain).connect(master);

        // vent: bandpassed noise, enveloped on hold
        const vent = ctx.createBufferSource();
        vent.buffer = snd.noise;
        vent.loop = true;
        const ventFilt = ctx.createBiquadFilter();
        ventFilt.type = "bandpass";
        ventFilt.frequency.value = 1400;
        ventFilt.Q.value = 0.8;
        const ventGain = ctx.createGain();
        ventGain.gain.value = 0.0001;
        vent.connect(ventFilt).connect(ventGain).connect(master);

        // klaxon: two alternating squares, gated
        const mk = (f) => {
          const o = ctx.createOscillator();
          o.type = "square";
          o.frequency.value = f;
          const g = ctx.createGain();
          g.gain.value = 0.0001;
          o.connect(g).connect(master);
          o.start();
          return [o, g];
        };
        const a = mk(660);
        const b = mk(880);

        hum.start();
        over.start();
        chugLfo.start();
        vent.start();

        Object.assign(snd, {
          humFilt, hum, humGain, chug, chugLfo, chugDepth,
          over, overFilt, overGain, vent, ventFilt, ventGain,
          alarmA: a[0], alarmGainA: a[1], alarmB: b[0], alarmGainB: b[1]
        });
        snd.ready = true;
        return true;
      }

      function setSound(on) {
        snd.on = on;
        if (on && !snd.ready) {
          if (!buildAudio()) {
            snd.on = false;
            return;
          }
        }
        if (!snd.ready) return;
        if (snd.ctx.state === "suspended") snd.ctx.resume();
        const t = snd.ctx.currentTime;
        snd.master.gain.cancelScheduledValues(t);
        snd.master.gain.setTargetAtTime(on ? 0.32 : 0, t, 0.06);
      }

      function burst(dur, hpf, peak) {
        if (!snd.ready || !snd.on) return;
        const ctx = snd.ctx;
        const t = ctx.currentTime;
        const s = ctx.createBufferSource();
        s.buffer = snd.noise;
        s.playbackRate.value = 1;
        const f = ctx.createBiquadFilter();
        f.type = "highpass";
        f.frequency.value = hpf;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(peak, t + 0.002);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        s.connect(f).connect(g).connect(snd.master);
        s.start(t);
        s.stop(t + dur + 0.02);
      }

      // relay clack: 15ms noise burst, hard envelope. Every switch and detent.
      const clack = () => burst(0.015, 1800, 0.5);
      const detent = () => burst(0.012, 2600, 0.22);

      function ruptureSound() {
        if (!snd.ready) return;
        const ctx = snd.ctx;
        const t = ctx.currentTime;
        // everything else falls silent
        [snd.humGain, snd.overGain, snd.ventGain, snd.alarmGainA, snd.alarmGainB].forEach((g) => {
          g.gain.cancelScheduledValues(t);
          g.gain.setTargetAtTime(0.0001, t, 0.08);
        });
        snd.dead = true;
        if (!snd.on) return;

        const s = ctx.createBufferSource();
        s.buffer = snd.noise;
        const lp = ctx.createBiquadFilter();
        lp.type = "lowpass";
        lp.frequency.setValueAtTime(7000, t);
        lp.frequency.exponentialRampToValueAtTime(70, t + 1.4);
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.85, t);
        g.gain.exponentialRampToValueAtTime(0.0002, t + 1.7);
        s.connect(lp).connect(g).connect(snd.master);
        s.start(t);
        s.stop(t + 1.8);

        // then a slow cooling tick
        for (let i = 0; i < 7; i++) {
          const at = t + 2.1 + i * 0.66;
          const ts = ctx.createBufferSource();
          ts.buffer = snd.noise;
          const tf = ctx.createBiquadFilter();
          tf.type = "bandpass";
          tf.frequency.value = 2400 - i * 180;
          tf.Q.value = 6;
          const tg = ctx.createGain();
          tg.gain.setValueAtTime(0.0001, at);
          tg.gain.linearRampToValueAtTime(0.3 * (1 - i / 8), at + 0.002);
          tg.gain.exponentialRampToValueAtTime(0.0001, at + 0.09);
          ts.connect(tf).connect(tg).connect(snd.master);
          ts.start(at);
          ts.stop(at + 0.12);
        }
      }

      function audioTick(st, dt) {
        if (!snd.ready || snd.dead) return;
        const ctx = snd.ctx;
        const t = ctx.currentTime;
        const f = st.feed / 100;
        const p = st.pressure / 100;
        snd.humFilt.frequency.setTargetAtTime(180 + f * 520, t, 0.12);
        snd.hum.frequency.setTargetAtTime(52 + f * 9, t, 0.2);
        snd.humGain.gain.setTargetAtTime(0.05 + f * 0.26, t, 0.1);
        snd.chugLfo.frequency.setTargetAtTime(1.6 + f * 7.5, t, 0.15);
        snd.chugDepth.gain.setTargetAtTime(0.18 + f * 0.3, t, 0.2);
        snd.overGain.gain.setTargetAtTime(Math.max(0, p - 0.35) * 0.14, t, 0.15);
        snd.over.frequency.setTargetAtTime(108 + p * 26, t, 0.2);
        snd.ventGain.gain.setTargetAtTime(st.venting ? 0.2 : 0.0001, t, st.venting ? 0.02 : 0.09);
        snd.ventFilt.frequency.setTargetAtTime(st.venting ? 900 + p * 2400 : 1200, t, 0.08);

        const alarm = st.running && (st.pressure >= RED_AT || st.temp >= RED_AT);
        if (alarm) {
          if (t - snd.flipAt > 0.22) {
            snd.flip = !snd.flip;
            snd.flipAt = t;
          }
          snd.alarmGainA.gain.setTargetAtTime(snd.flip ? 0.075 : 0.0001, t, 0.01);
          snd.alarmGainB.gain.setTargetAtTime(snd.flip ? 0.0001 : 0.075, t, 0.01);
        } else {
          snd.alarmGainA.gain.setTargetAtTime(0.0001, t, 0.04);
          snd.alarmGainB.gain.setTargetAtTime(0.0001, t, 0.04);
        }
      }

      /* =====================================================================
         GAUGES. Canvas needles, 240 degrees of sweep, eased unless the
         visitor has asked for reduced motion.
         ===================================================================== */
      function Gauge(id, opts) {
        const canvas = $(id);
        const ctx = canvas.getContext("2d");
        return {
          canvas,
          ctx,
          disp: 0,
          red: opts.red || 0,
          amber: opts.amber || 0,
          w: 0,
          h: 0,
          fit() {
            const dpr = Math.min(2, window.devicePixelRatio || 1);
            const cssW = canvas.clientWidth || 260;
            const cssH = Math.round(cssW * 0.63);
            canvas.style.height = cssH + "px";
            canvas.width = Math.round(cssW * dpr);
            canvas.height = Math.round(cssH * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            this.w = cssW;
            this.h = cssH;
          },
          draw(value, dt) {
            if (reduceMotion) this.disp = value;
            else this.disp += (value - this.disp) * Math.min(1, dt * 8.5);
            paint(this, this.disp);
          }
        };
      }

      const A0 = Math.PI * (7 / 6);   // 210 degrees
      const A1 = Math.PI * (-1 / 6);  // -30 degrees
      const ang = (v) => A0 + (A1 - A0) * (clamp(v, 0, 100) / 100);

      function paint(g, v) {
        const c = g.ctx;
        const w = g.w;
        const h = g.h;
        const cx = w / 2;
        const cy = h * 0.82;
        const r = Math.min(w * 0.44, h * 0.82);
        c.clearRect(0, 0, w, h);

        // bezel
        c.beginPath();
        c.arc(cx, cy, r + 7, A0 - 0.16, A1 + 0.16);
        c.lineWidth = 12;
        c.strokeStyle = "#1a1f21";
        c.stroke();

        // face
        const face = c.createRadialGradient(cx - r * 0.3, cy - r * 0.6, r * 0.1, cx, cy, r * 1.25);
        face.addColorStop(0, "#f2efe3");
        face.addColorStop(1, "#c6c3b5");
        c.beginPath();
        c.moveTo(cx, cy);
        c.arc(cx, cy, r + 1, A0, A1);
        c.closePath();
        c.fillStyle = face;
        c.fill();

        // hazard band then alarm band, drawn on the rim
        const band = (from, to, colour) => {
          c.beginPath();
          c.arc(cx, cy, r - 5, ang(from), ang(to));
          c.lineWidth = 7;
          c.strokeStyle = colour;
          c.stroke();
        };
        if (g.amber) band(g.amber, g.red ? g.red : 100, "#d4762a");
        if (g.red) band(g.red, 100, "#c4342c");

        // ticks
        for (let i = 0; i <= 100; i += 5) {
          const a = ang(i);
          const major = i % 25 === 0;
          const i0 = major ? r - 20 : r - 13;
          c.beginPath();
          c.moveTo(cx + Math.cos(a) * i0, cy + Math.sin(a) * i0);
          c.lineTo(cx + Math.cos(a) * (r - 7), cy + Math.sin(a) * (r - 7));
          c.lineWidth = major ? 2.4 : 1;
          c.strokeStyle = major ? "#20241f" : "#5c5f56";
          c.stroke();
          if (major) {
            c.fillStyle = "#20241f";
            c.font = "700 " + Math.max(8, Math.round(r * 0.13)) + "px ui-monospace, monospace";
            c.textAlign = "center";
            c.textBaseline = "middle";
            c.fillText(String(i), cx + Math.cos(a) * (r - 31), cy + Math.sin(a) * (r - 31));
          }
        }

        // needle
        const a = ang(v);
        c.save();
        c.translate(cx, cy);
        c.rotate(a);
        c.beginPath();
        c.moveTo(-r * 0.2, 2.6);
        c.lineTo(r - 12, 0.9);
        c.lineTo(r - 12, -0.9);
        c.lineTo(-r * 0.2, -2.6);
        c.closePath();
        c.fillStyle = "#23262a";
        c.fill();
        c.restore();

        // hub
        c.beginPath();
        c.arc(cx, cy, r * 0.11, 0, Math.PI * 2);
        c.fillStyle = "#3a3f3c";
        c.fill();
        c.lineWidth = 1.5;
        c.strokeStyle = "#191d1b";
        c.stroke();

        // glass
        const gl = c.createLinearGradient(0, 0, w, h);
        gl.addColorStop(0, "rgba(255,255,255,0.22)");
        gl.addColorStop(0.45, "rgba(255,255,255,0.02)");
        gl.addColorStop(1, "rgba(0,0,0,0.06)");
        c.beginPath();
        c.moveTo(cx, cy);
        c.arc(cx, cy, r + 1, A0, A1);
        c.closePath();
        c.fillStyle = gl;
        c.fill();
      }

      const gauges = {
        feed: Gauge("gFeed", { amber: 70 }),
        press: Gauge("gPress", { amber: TEMP_KNEE, red: RED_AT }),
        temp: Gauge("gTemp", { red: RED_AT })
      };

      /* =====================================================================
         STATE
         ===================================================================== */
      const st = {
        shift: 1,
        running: false,
        feed: 0,
        pressure: 0,
        temp: 0,
        coolant: 100,
        coolantOn: false,
        venting: false,
        units: 0,
        loss: 0,
        faults: 0,
        left: SHIFT_SECONDS,
        pressPin: 0,
        tempPin: 0,
        fault: null,
        faultAt: 0,
        holding: null,
        holdFor: 0,
        quota: quotaFor(1)
      };

      let best = null;
      try {
        const raw = localStorage.getItem(STORE_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          if (p && typeof p.shift === "number" && typeof p.units === "number") best = p;
        }
      } catch (e) { /* storage unavailable or blocked. The panel does not care. */ }

      // Best single shift by units. Shift number alone is meaningless here,
      // because the shift number only ever goes up.
      function saveBest() {
        const units = Math.floor(st.units);
        if (!best || units > best.units) {
          best = { shift: st.shift, units: units };
          try { localStorage.setItem(STORE_KEY, JSON.stringify(best)); } catch (e) { /* ignore */ }
        }
      }

      const el = {
        console: $("console"),
        statusText: $("statusText"),
        lever: $("lever"),
        vent: $("ventBtn"),
        cool: $("coolSw"),
        sound: $("soundSw"),
        coolBar: $("coolBar"),
        coolNote: $("coolNote"),
        klaxon: $("klaxon"),
        status: $("status"),
        shiftPlate: $("shiftPlate"),
        clockPlate: $("clockPlate"),
        vUnits: $("vUnits"),
        vQuota: $("vQuota"),
        vLoss: $("vLoss"),
        vFaults: $("vFaults"),
        vRecord: $("vRecord"),
        nFeed: $("nFeed"),
        nPress: $("nPress"),
        nTemp: $("nTemp"),
        veil: $("veil"),
        briefing: $("briefing"),
        slip: $("slip"),
        startBtn: $("startBtn"),
        nextBtn: $("nextBtn"),
        lamps: { feed: $("lampFeed"), vent: $("lampVent"), cool: $("lampCool") },
        resets: { feed: $("resFeed"), vent: $("resVent"), cool: $("resCool") }
      };

      /* =====================================================================
         HOLD-TO-ACT. Pointer and keyboard, both real holds.
         ===================================================================== */
      function holdable(node, down, up) {
        let active = false;
        const start = (e) => {
          if (active) return;
          active = true;
          if (e && e.preventDefault) e.preventDefault();
          down();
        };
        const stop = () => {
          if (!active) return;
          active = false;
          up();
        };
        node.addEventListener("pointerdown", start);
        node.addEventListener("pointerup", stop);
        node.addEventListener("pointercancel", stop);
        node.addEventListener("pointerleave", stop);
        node.addEventListener("keydown", (e) => {
          if (e.key === " " || e.key === "Enter" || e.key === "Spacebar") {
            e.preventDefault();
            if (!e.repeat) start();
          }
        });
        node.addEventListener("keyup", (e) => {
          if (e.key === " " || e.key === "Enter" || e.key === "Spacebar") stop();
        });
        node.addEventListener("blur", stop);
        node.addEventListener("click", (e) => e.preventDefault());
        window.addEventListener("pointerup", stop);
      }

      holdable(
        el.vent,
        () => {
          if (!st.running) return;
          st.venting = true;
          el.vent.classList.add("on");
          clack();
        },
        () => {
          st.venting = false;
          el.vent.classList.remove("on");
        }
      );

      SYS_KEYS.forEach((key) => {
        const node = el.resets[key];
        holdable(
          node,
          () => {
            if (!st.running) return;
            st.holding = key;
            st.holdFor = 0;
            clack();
          },
          () => {
            if (st.holding === key) {
              st.holding = null;
              st.holdFor = 0;
              node.querySelector("b").style.width = "0%";
            }
          }
        );
      });

      // lever: detent clack on every 10 crossed, relay clack on release
      let lastDetent = 0;
      el.lever.addEventListener("input", () => {
        st.feed = Number(el.lever.value);
        const d = Math.floor(st.feed / 10);
        if (d !== lastDetent) {
          lastDetent = d;
          detent();
        }
      });
      el.lever.addEventListener("change", () => clack());

      el.cool.addEventListener("change", () => {
        st.coolantOn = el.cool.checked && st.coolant > 0;
        if (!st.coolantOn) el.cool.checked = false;
        clack();
      });

      el.sound.addEventListener("change", () => {
        setSound(el.sound.checked);
        if (el.sound.checked) clack();
      });

      /* =====================================================================
         SHIFT LIFECYCLE
         ===================================================================== */
      function beginShift() {
        st.running = true;
        st.feed = 0;
        st.pressure = 0;
        st.temp = 0;
        st.coolant = 100;
        st.coolantOn = false;
        st.venting = false;
        st.units = 0;
        st.loss = 0;
        st.faults = 0;
        st.left = SHIFT_SECONDS;
        st.pressPin = 0;
        st.tempPin = 0;
        st.fault = null;
        st.holding = null;
        st.holdFor = 0;
        st.quota = quotaFor(st.shift);
        st.faultAt = clock + FAULT_MIN + Math.random() * (FAULT_MAX - FAULT_MIN);
        lastDetent = 0;
        el.lever.value = "0";
        el.cool.checked = false;
        el.vent.classList.remove("on");
        SYS_KEYS.forEach((k) => {
          el.lamps[k].classList.remove("lit");
          el.resets[k].querySelector("b").style.width = "0%";
        });
        el.veil.hidden = true;
        el.console.classList.remove("shake");
        snd.dead = false;
        if (snd.ready && snd.on) {
          const t = snd.ctx.currentTime;
          snd.master.gain.setTargetAtTime(0.32, t, 0.08);
        }
        statusNow("SHIFT " + st.shift + " RUNNING. QUOTA " + st.quota + " UNITS.");
        announceAt = clock;
        el.lever.focus({ preventScroll: true });
      }

      function endShift(cause) {
        if (!st.running) return;
        st.running = false;
        st.venting = false;
        st.coolantOn = false;
        st.holding = null;
        el.vent.classList.remove("on");
        el.cool.checked = false;
        el.console.classList.remove("shake");

        const hard = cause === "RUPTURE" || cause === "SEIZURE";
        if (hard) ruptureSound();
        else if (snd.ready) {
          const t = snd.ctx.currentTime;
          [snd.humGain, snd.overGain, snd.ventGain, snd.alarmGainA, snd.alarmGainB].forEach((g) =>
            g.gain.setTargetAtTime(0.0001, t, 0.15)
          );
          snd.dead = true;
        }

        const units = Math.floor(st.units);
        const ratio = units / st.quota;
        let line;
        if (hard) line = ASSESS.ruptured;
        else if (ratio >= 1 && st.faults === 0 && st.loss < st.quota * 0.25) line = ASSESS.tolerance;
        else if (ratio >= 1) line = ASSESS.survived;
        else if (ratio >= 0.7) line = ASSESS.present;
        else line = ASSESS.short;

        saveBest();
        paintRecord();

        $("dShift").textContent = String(st.shift);
        $("dDur").textContent = mmss(SHIFT_SECONDS - st.left);
        $("dUnits").textContent = String(units);
        $("dQuota").textContent = String(st.quota);
        $("dLoss").textContent = String(Math.floor(st.loss));
        $("dFaults").textContent = String(st.faults);
        $("dEnd").textContent = hard ? cause : "CLOCK";
        $("dAssess").textContent = line;

        statusNow(cause + ". " + units + " UNITS OF " + st.quota + ". " + line);

        el.briefing.hidden = true;
        el.slip.hidden = false;
        // re-trigger the paper feed animation
        el.slip.style.animation = "none";
        void el.slip.offsetWidth;
        el.slip.style.animation = "";
        el.veil.hidden = false;
        el.nextBtn.focus({ preventScroll: true });
      }

      el.startBtn.addEventListener("click", () => {
        clack();
        beginShift();
      });
      el.nextBtn.addEventListener("click", () => {
        clack();
        st.shift += 1;
        beginShift();
      });

      /* =====================================================================
         READOUTS
         ===================================================================== */
      // The klaxon lamp is a real element in the template, so it keeps its
      // scoped styling. Only the text node is ever rewritten.
      let lastStatus = "";
      function statusNow(text) {
        if (text === lastStatus) return;
        lastStatus = text;
        el.statusText.textContent = text;
      }

      function paintRecord() {
        el.vRecord.textContent = best ? "S" + best.shift + "/" + best.units : "—";
      }
      paintRecord();

      let announceAt = 0;
      function readouts(now) {
        el.nFeed.textContent = pad(st.feed, 3);
        el.nPress.textContent = pad(st.pressure, 3);
        el.nTemp.textContent = pad(st.temp, 3);
        el.vUnits.textContent = pad(st.units, 4);
        el.vQuota.textContent = pad(st.quota, 4);
        el.vLoss.textContent = pad(st.loss, 4);
        el.vFaults.textContent = pad(st.faults, 2);
        el.shiftPlate.textContent = "SHIFT " + st.shift;
        el.clockPlate.textContent = mmss(st.left) + " REMAINING";
        el.coolBar.style.transform = "scaleX(" + (st.coolant / 100).toFixed(3) + ")";
        el.coolNote.textContent =
          st.coolant <= 0
            ? "RESERVE EMPTY"
            : st.feed < COOL_FEED_MAX && !st.coolantOn
              ? "REFILLING"
              : "REFILLS BELOW FEED 40";

        const red = st.running && (st.pressure >= RED_AT || st.temp >= RED_AT);
        el.klaxon.classList.toggle("lit", red);

        const pinned = st.running && (st.pressPin > 0 || st.tempPin > 0);
        if (!reduceMotion) el.console.classList.toggle("shake", pinned);

        // aria-live: throttled so a screen reader is not read a number 60x a second
        if (st.running && now - announceAt > 5) {
          announceAt = now;
          let line =
            "SHIFT " + st.shift + ". " + pad(st.units, 1) + " UNITS OF " + st.quota +
            ". " + mmss(st.left) + " REMAINING. PRESSURE " + pad(st.pressure, 1) +
            ". TEMPERATURE " + pad(st.temp, 1) + ".";
          if (st.fault) line += " FAULT: " + SYS[st.fault].label + ".";
          if (red) line += " ALARM.";
          statusNow(line);
        }
      }

      /* =====================================================================
         PHYSICS
         ===================================================================== */
      function step(dt, now) {
        st.left -= dt;

        // ---- faults
        if (!st.fault && now >= st.faultAt) {
          st.fault = SYS_KEYS[Math.floor(Math.random() * SYS_KEYS.length)];
          st.faults += 1;
          el.lamps[st.fault].classList.add("lit");
          burst(0.05, 900, 0.35);
          statusNow("FAULT: " + SYS[st.fault].label + ". HOLD RESET.");
          announceAt = now;
        }
        if (st.holding) {
          st.holdFor += dt;
          const bar = el.resets[st.holding].querySelector("b");
          bar.style.width = Math.min(100, (st.holdFor / RESET_HOLD) * 100).toFixed(1) + "%";
          if (st.holdFor >= RESET_HOLD) {
            if (st.fault === st.holding) {
              el.lamps[st.fault].classList.remove("lit");
              st.fault = null;
              st.faultAt = now + FAULT_MIN + Math.random() * (FAULT_MAX - FAULT_MIN);
              statusNow("FAULT CLEARED.");
              announceAt = now;
            }
            clack();
            st.holdFor = 0;
            bar.style.width = "0%";
          }
        }

        // ---- output
        let mul = 1;
        if (st.fault === "feed") mul *= 0.6;
        if (st.holding) mul *= 0.5;
        if (st.venting) mul = 0;
        st.units += st.feed * OUTPUT_PER_FEED * mul * dt;

        // ---- pressure
        const ventEff = st.venting ? VENT_RATE * (st.fault === "vent" ? 0.4 : 1) : 0;
        st.pressure = clamp(
          st.pressure + ((st.feed - PRESS_NEUTRAL) * PRESS_GAIN - ventEff) * dt,
          0,
          100
        );
        if (st.venting) st.loss += LOSS_PER_SEC * dt;

        // ---- coolant
        let coolEff = 0;
        if (st.coolantOn && st.coolant > 0) {
          coolEff = COOL_RATE * (st.fault === "cool" ? 0.4 : 1);
          st.coolant -= COOL_DRAIN * dt;
          if (st.coolant <= 0) {
            st.coolant = 0;
            st.coolantOn = false;
            el.cool.checked = false;
            clack();
            statusNow("COOLANT RESERVE EMPTY.");
            announceAt = now;
          }
        }
        if (!st.coolantOn && st.feed < COOL_FEED_MAX) {
          st.coolant = Math.min(100, st.coolant + COOL_REFILL * dt);
        }

        // ---- temperature
        const knee = Math.max(0, st.pressure - TEMP_KNEE) * TEMP_KNEE_GAIN;
        st.temp = clamp(
          st.temp +
            (st.feed * TEMP_FEED + knee - TEMP_AMBIENT - TEMP_LEAK * st.temp - coolEff) * dt,
          0,
          100
        );

        // ---- failure
        st.pressPin = st.pressure >= 99.5 ? st.pressPin + dt : 0;
        st.tempPin = st.temp >= 99.5 ? st.tempPin + dt : 0;
        if (st.pressPin >= PIN_LIMIT) { endShift("RUPTURE"); return; }
        if (st.tempPin >= PIN_LIMIT) { endShift("SEIZURE"); return; }
        if (st.left <= 0) { st.left = 0; endShift("CLOCK"); return; }
      }

      /* =====================================================================
         LOOP
         ===================================================================== */
      let last = 0;
      let clock = 0;
      function frame(ms) {
        const t = ms / 1000;
        let dt = last ? t - last : 0;
        last = t;
        if (dt > 0.05) dt = 0.05;      // clamp: a hidden tab cannot rupture the unit
        if (dt < 0) dt = 0;
        if (st.running) {
          clock += dt;
          step(dt, clock);
        }
        gauges.feed.draw(st.feed, dt);
        gauges.press.draw(st.pressure, dt);
        gauges.temp.draw(st.temp, dt);
        readouts(clock);
        if (st.running) audioTick(st, dt);
        requestAnimationFrame(frame);
      }

      function fitAll() {
        gauges.feed.fit();
        gauges.press.fit();
        gauges.temp.fit();
      }
      fitAll();
      window.addEventListener("resize", fitAll);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) last = 0;
      });

      readouts(0);
      requestAnimationFrame(frame);
    </script>
  </body>
</html>
