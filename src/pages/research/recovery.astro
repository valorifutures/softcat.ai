  .study-section { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.6fr); gap: 2rem 4rem; padding-top: 3.5rem; margin-top: 3.5rem; border-top: 1px solid var(--workshop-rule); scroll-margin-top: 6rem; }
  #lost-reply { margin-top: 0; border-top: 0; }
  .section-heading h2 { color: #eef0e7; font: 500 clamp(1.6rem, 2.7vw, 2rem)/1.25 var(--font-sans); letter-spacing: -.035em; margin-block: 1rem; }
  .section-heading > p:not(.eyebrow), .reproduction-copy { color: var(--color-text-muted); font-size: .84rem; line-height: 1.85; margin-bottom: 1rem; }
  .section-heading .text-link { margin-top: .2rem; font-size: .75rem; }
  .section-content { min-width: 0; }
  .recovery-sequence { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .recovery-sequence > li { display: grid; grid-template-columns: 6.2rem minmax(0, 1fr); gap: .3rem 1.2rem; border: 1px solid #384034; border-left: 3px solid #9cab90; padding: 1.2rem 1.3rem; background: #161c16; }
  .recovery-sequence .uncertain { background: #211d15; border-color: #554a36; border-left-color: #d1b980; }
  .step-label { color: #b7c4ac; font: .58rem/1.8 var(--font-mono); letter-spacing: .08em; padding-top: .1rem; }
  .uncertain .step-label { color: #dac396; }
  .recovery-sequence h3 { color: #e0e7d8; font: 500 1rem/1.5 var(--font-sans); }
  .recovery-sequence p { grid-column: 2; color: #a8b1a1; font-size: .76rem; line-height: 1.8; }
  .caption { color: #9da895; font-size: .73rem; line-height: 1.85; margin-top: 1rem; }
  summary { color: #d4dccc; font-size: .76rem; line-height: 1.7; min-height: 44px; padding-block: .7rem; cursor: pointer; }
  summary:hover, .section-links a:hover, .back-link:hover { color: var(--workshop-lime); }
  .featured-trace { margin-top: 1.2rem; border: 1px solid #46533d; padding: .5rem 1.2rem; }
