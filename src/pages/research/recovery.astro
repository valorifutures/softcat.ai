  .limits strong { color: #e0e5da; font-weight: 500; }
  .next-step { border-top: 1px solid #45513c; margin-top: 2rem; padding-top: 1.6rem; }
  .next-step .eyebrow { color: #aec49b; margin-bottom: .8rem; }
  .next-step a { margin-top: .8rem; }
  .charter { color: #9ca794; font-size: .75rem; line-height: 1.8; margin-top: 1.5rem; }
  .recovery-page a:focus-visible, .recovery-page summary:focus-visible, .recovery-page pre:focus-visible { outline: 2px solid var(--workshop-lime); outline-offset: 4px; border-radius: 2px; }
