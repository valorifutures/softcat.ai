  .featured-trace[open] > summary::after { content: '−'; }
  .featured-trace summary strong { color: #e0e8d7; font-weight: 500; }
  .featured-trace summary small { display: block; color: #a6b09e; font-size: .66rem; margin-top: .2rem; }
  .event-list { list-style: none; margin-block: 1.3rem; padding: 0; }
  .event-list > li { display: grid; grid-template-columns: 1.7rem minmax(0, 1fr); gap: .5rem; border-top: 1px solid #303b2a; }
