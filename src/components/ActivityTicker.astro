---
import allRuns from '../data/pipeline/runs.json';
import allBots from '../data/pipeline/bots.json';
import { newestRun, overdueHours } from '../lib/pipeline-status.mjs';
import RecordedTime from './RecordedTime.astro';
import RunState from './RunState.astro';
const latest = newestRun(allRuns);
const bot = allBots.find((b) => b.id === latest?.bot);
---
<section class="max-w-5xl mx-auto px-6 py-5" aria-label="Pipeline record">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-surface-light py-4 font-mono text-xs text-text-muted">
    <a href="/pipeline" class="text-neon-cyan hover:underline">Pipeline record ↗</a>
    {latest ? <>
      <span>Latest logged run: {bot?.name ?? latest.bot}</span>
      <RecordedTime value={latest.timestamp} />
      <RunState run={latest} threshold={overdueHours(bot?.schedule_cron)} />
    </> : <span>No dated run is recorded.</span>}
  </div>
</section>
