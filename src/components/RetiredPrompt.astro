---
import BaseLayout from '../layouts/BaseLayout.astro';
import review from '../data/prompt-retirements.json';
import '../styles/prompt-recipes.css';
interface Props { retirement: typeof review.entries[number]; }
const { retirement } = Astro.props;
const date = (value: string) => new Date(value).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="Retired prompt template" description="This earlier SOFT CAT prompt was retired during the collection review. The original title and exact Git source remain recorded.">
  <Fragment slot="head"><meta name="robots" content="noindex, follow" /></Fragment>
  <article class="recipe-page recipe-retired workshop-shell"><header><a href="/prompts/review" class="text-link">← The prompt review</a><p class="eyebrow">EDITORIAL RECORD / RETIRED TEMPLATE</p><h1>This prompt has left<br /><em>the active library.</em></h1><p class="recipe-date">Retired <time datetime={retirement.retiredAt}>{date(retirement.retiredAt)}</time></p></header><div class="recipe-limits"><h2>Why it was removed</h2><p>{review.reason}</p></div><section><p class="eyebrow">ORIGINAL TITLE</p><h2>{retirement.title}</h2><p class="recipe-small">Its first recorded Git commit is dated <time datetime={retirement.gitRecordedDate}>{date(retirement.gitRecordedDate)}</time>. The old template did not carry a publication date, so this is a source-history date.</p><a class="text-link" href={`https://github.com/valorifutures/softcat.ai/blob/${retirement.sourceRevision}/${retirement.sourcePath}`}>Read the preserved template ↗</a></section><p class="recipe-small">For a defined task with sample inputs and explicit checks, start with <a href="/prompts">the current prompt recipes</a>. For actual code-based JSON checking, use <a href="/lab/json-validator">the JSON validator</a>.</p></article>
</BaseLayout>
