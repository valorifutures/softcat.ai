---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipePrompt from './RecipePrompt';
import { render, type CollectionEntry } from 'astro:content';
import { recipeExample } from '../lib/prompt-recipes.mjs';
import { jsonValidationRecipeHref } from '../lib/json-validation-presets.mjs';
import '../styles/prompt-recipes.css';
interface Props { entry: CollectionEntry<'prompts'>; }
const { entry } = Astro.props;
const recipe = entry.data.recipe!;
const toolHref = recipe.tool === '/lab/json-validator' ? jsonValidationRecipeHref(entry.id) ?? recipe.tool : recipe.tool;
const { Content } = await render(entry);
const checked = new Date(recipe.reviewedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="recipe-page workshop-shell">
    <header><a href="/prompts" class="text-link">← Prompt recipes</a><p class="eyebrow">{entry.data.category.replaceAll('-', ' ').toUpperCase()} / A WORKED STARTING POINT</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p><p class="recipe-date">Template reviewed <time datetime={recipe.reviewedAt}>{checked}</time></p></header>
    <section class="recipe-setup" aria-labelledby="recipe-input-heading"><div><p class="eyebrow">WHEN TO USE IT</p><p>{recipe.when}</p></div><div><h2 id="recipe-input-heading">Bring these inputs</h2><dl>{Object.entries(recipe.inputs).map(([name, description]) => <div><dt>{`{{${name}}}`}</dt><dd>{description}</dd></div>)}</dl></div></section>
    <section aria-labelledby="recipe-prompt-heading"><p class="eyebrow">01 / THE PROMPT</p><h2 id="recipe-prompt-heading">A template you can inspect.</h2><RecipePrompt template={entry.data.prompt} example={recipeExample(entry.data)} id={entry.id} client:load /></section>
    <section class="recipe-target" aria-labelledby="recipe-target-heading"><p class="eyebrow">02 / THE EXAMPLE TARGET</p><h2 id="recipe-target-heading">What a useful result should contain.</h2><p>This is a target for the worked example, not a recorded model response. Equivalent wording can be valid where the task allows it.</p><pre tabindex="0" role="region" aria-label="Example target result">{recipe.expected}</pre></section>
    <section class="recipe-checks" aria-labelledby="recipe-checks-heading"><p class="eyebrow">03 / JUDGE THE RESULT</p><h2 id="recipe-checks-heading">Check the answer, not the confidence.</h2><ul>{recipe.checks.map(check => <li>{check}</li>)}</ul>{toolHref && <a class="text-link" href={toolHref}>{jsonValidationRecipeHref(entry.id) ? 'Check this example’s JSON contract' : 'Open the related workshop tool'} ↗</a>}</section>
    <aside class="recipe-limits"><h2>What this does not establish</h2><p>{recipe.limits}</p></aside><div class="recipe-history"><Content /><a href="/prompts/review">Read the prompt collection review ↗</a></div>
  </article>
</BaseLayout>
