---
import predictionHistory from '../data/horizon/prediction-history.json';
import { latestPredictions } from '../lib/horizon-predictions.mjs';
import { FUTURES } from '../lib/horizon-explorer.mjs';
const predictions = latestPredictions(predictionHistory);
const futures = FUTURES.map(future => ({ ...future, ...predictions.find(item => item.id === future.id) }));
const targetDate = (value: string) => new Date(`${value}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<section class="workshop-shell workshop-hero">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-square" aria-hidden="true"></span> AN INDEPENDENT AI WORKSHOP</p>
    <h1>Understand what’s <em>next.</em><br />Try what works.</h1>
    <p class="hero-description">Our predictions for what AI does next.<br class="hidden sm:block" /> See our target dates, inspect the evidence,<br class="hidden sm:block" /> then try the tools for yourself.</p>
    <div class="hero-actions">
      <a href="/horizon" class="workshop-button primary">Explore Horizon <span aria-hidden="true">↗</span></a>
      <a href="/tools" class="workshop-button quiet">Try the tools <span aria-hidden="true">→</span></a>
    </div>
    <p class="hero-footnote">BUILT WITH AI. KEPT OPEN TO INSPECTION.</p>
  </div>
  <div class="hero-horizon">
    <div class="hero-horizon-top"><span>HORIZON</span><span>OUR PUBLISHED VIEW</span></div>
    <h2>Our predictions.<br />Five countdowns.</h2>
    <p class="hero-horizon-label">Our target date for each defined milestone</p>
    <ul>{futures.map((future, index) => <li><a href={`/horizon?future=${future.key}`}><span class="hero-future-number" aria-hidden="true">0{index + 1}</span><span>{future.title}</span><time class="hero-future-date" datetime={future.target_date}>{targetDate(future.target_date)}</time><span aria-hidden="true">↗</span></a></li>)}</ul>
    <div class="hero-horizon-bottom"><span>Evidence can change our prediction.</span><a href="/horizon">See the countdowns →</a></div>
  </div>
</section>

<style>
  .hero-horizon { background: #f5f4ee; color: #1d2c23; padding: 1.6rem 1.75rem; border-top: 5px solid #c5e59e; }
  .hero-horizon-top { display: flex; justify-content: space-between; gap: 1rem; color: #53634f; font: 0.65rem var(--font-mono); letter-spacing: .06em; }
  .hero-horizon h2 { font: 600 clamp(1.9rem, 3vw, 2.5rem)/1.1 var(--font-sans); letter-spacing: -.05em; margin: 1.6rem 0; }
  .hero-horizon-label { color: #59665c; font-size: .72rem; padding-bottom: .6rem; }
  .hero-horizon ul { list-style: none; padding: 0; margin: 0; }
  .hero-horizon li { border-top: 1px solid #d5dbcf; }
  .hero-horizon li a { display: grid; grid-template-columns: 1.25rem 1fr auto .7rem; gap: .5rem; align-items: center; min-height: 49px; font-size: .82rem; }
  .hero-horizon li a:hover { color: #365e2b; background: #e6eddd; }
  .hero-horizon a:focus-visible { outline: 2px solid #365e2b; outline-offset: 3px; }
  .hero-future-number, .hero-future-date { font: .68rem var(--font-mono); }
  .hero-future-number { color: #677561; }
  .hero-future-date { font-weight: 600; }
  .hero-horizon-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .6rem 1rem; border-top: 1px solid #c0cbb6; margin-top: .3rem; padding-top: 1rem; font-size: .72rem; }
  .hero-horizon-bottom > span { color: #59665c; }
  .hero-horizon-bottom a { text-decoration: underline; text-underline-offset: 3px; }
  @media(max-width: 1000px) and (min-width: 761px) { .hero-horizon { padding: 1.2rem; } .hero-horizon-top { font-size: .55rem; } .hero-future-number { display: none; } .hero-horizon li a { grid-template-columns: 1fr auto .7rem; font-size: .75rem; } }
  @media(max-width: 380px) { .hero-horizon { padding: 1.3rem 1rem; } .hero-horizon-top { font-size: .58rem; } .hero-future-number { display: none; } .hero-horizon li a { grid-template-columns: 1fr auto .7rem; } }
</style>
