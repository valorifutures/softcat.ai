---
const links = [
  { label: 'Horizon', href: '/horizon' },
  { label: 'Tools', href: '/tools' },
  { label: 'Recipes', href: '/prompts' },
  { label: 'Notebook', href: '/notebook' },
  { label: 'Feral', href: '/feral' },
  { label: 'Pipeline', href: '/pipeline' },
];
const isCurrent = (href: string) => Astro.url.pathname === href || Astro.url.pathname.startsWith(href + '/') || (href === '/tools' && Astro.url.pathname.startsWith('/lab/'));
---
<header class="workshop-header">
  <div class="workshop-shell header-inner">
    <a href="/" class="site-brand" aria-label="SOFT CAT .ai home"><svg aria-hidden="true" viewBox="0 0 32 32" fill="none"><path d="M5 21V5L11 11C14 9 18 9 21 11L27 5V21C27 29 5 29 5 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M10 17L13 19L10 21M22 17L19 19L22 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span>SOFT CAT<span class="brand-domain">.ai</span></span></a>
    <nav class="desktop-navigation" aria-label="Main navigation">{links.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
    <div class="header-controls">
      <button data-search-trigger class="header-search" aria-label="Search the site"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M16 16L21 21"/></svg></button>
      <details class="mobile-navigation" id="site-menu"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{links.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}<a href="/news-and-updates">News archive</a><a href="/radar">Radar archive</a></nav></details>
    </div>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('#site-menu');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
  });
  document.addEventListener('click', (event) => { if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
  document.querySelectorAll('[data-search-trigger]').forEach((element) => element.addEventListener('click', () => (window as any).__searchOpen?.()));
</script>
