---
import PostLayout from '../layouts/PostLayout.astro';
import RelatedPosts from './RelatedPosts.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'thoughts'>; }

const { entry } = Astro.props;
const { Content } = await render(entry);
const words = entry.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(words / 200));

const allEntries = (await getCollection('thoughts')).filter((e) => !e.data.draft && e.id !== entry.id);
const relatedPosts = allEntries
  .filter((e) => !entry.data.tags.includes('field-notes') || e.data.tags.includes('field-notes'))
  .filter((e) => e.data.tags.some((t) => entry.data.tags.includes(t)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((e) => ({ title: e.data.title, url: `/thoughts/${e.id}`, date: e.data.date }));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://softcat.ai" },
    { "@type": "ListItem", "position": 2, "name": entry.data.tags.includes('field-notes') ? "Notebook" : "Thoughts", "item": entry.data.tags.includes('field-notes') ? "https://softcat.ai/notebook" : "https://softcat.ai/thoughts" },
    { "@type": "ListItem", "position": 3, "name": entry.data.title, "item": `https://softcat.ai/thoughts/${entry.id}` },
  ],
};
---

<PostLayout
  title={entry.data.title}
  date={entry.data.date}
  tags={entry.data.tags}
  summary={entry.data.summary}
  backLink={entry.data.tags.includes('field-notes') ? '/notebook' : '/thoughts'}
  backLabel={entry.data.tags.includes('field-notes') ? 'Notebook' : 'Thoughts'}
  readingTime={readingTime}
  generated_by={entry.data.generated_by}
  model={entry.data.model}
  generation_time_s={entry.data.generation_time_s}
  cost_usd={entry.data.cost_usd}
  correction={entry.data.correction}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <Content />
  {relatedPosts.length > 0 && <RelatedPosts posts={relatedPosts} />}
</PostLayout>
