---
import BaseLayout from '../layouts/BaseLayout.astro';
import HorizonExplorer from './HorizonExplorer';
import HorizonDefinition from './HorizonDefinition';
import scenarios from '../data/horizon/scenarios.json';
import review from '../data/horizon/outlook-review.json';
import past from '../data/horizon/past.json';
import now from '../data/horizon/now.json';
import next from '../data/horizon/next.json';
import debates from '../data/horizon/debates.json';
import '../styles/horizon.css';
const fmt = (value: string) => new Date(`${value}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const legacyIds = [...new Set([...past, ...now, ...next, ...debates, ...scenarios].map(entry => entry.id).concat(['past', 'now', 'next', 'compare', 'debates', 'shifts']))];
---
<BaseLayout title="Horizon: what comes after now?" description="Explore five possible AI futures. Compare optimistic, pragmatic and sceptical scenarios, inspect the evidence and ask whether AGI is already here.">
  <div class="horizon-page"><div class="hz-shell">
    <header class="hz-hero">
      <div><p class="hz-label">Horizon / An open view of AI</p><h1>What comes<br />after now?</h1></div>
      <div class="hz-hero-intro"><p><strong>Five possible futures. Plenty to question.</strong><br />Explore when they could arrive, what has to work and what could hold them back.</p><nav class="hz-hero-links" aria-label="Explore Horizon"><a href="#agi-question">Is AGI already here? ↓</a><a href="/horizon/record#past">How we got here →</a></nav></div>
    </header>
    <HorizonExplorer client:load scenarios={scenarios} review={review} referenceYear={new Date().getUTCFullYear()} />
    <HorizonDefinition client:load reviewedAt={review.reviewed_at} />
    <section class="hz-reading" aria-label="Go deeper into Horizon">
      <a href="/horizon/record#now"><p class="hz-label">01 / What we can observe</p><h2>The signals</h2><p>Dated observations, the original sources and what each one actually establishes.</p><span>Read the current record ↗</span></a>
      <a href="/horizon/record#past"><p class="hz-label">02 / How we got here</p><h2>The turning points</h2><p>From earlier breakthroughs to the tools and ideas that shaped today’s AI.</p><span>Explore the history ↗</span></a>
      <a href="/horizon/review"><p class="hz-label">03 / When our view changes</p><h2>The review record</h2><p>Original claims, revisions and withdrawals. A useful outlook has room to change its mind.</p><span>Inspect the decisions ↗</span></a>
    </section>
    <details class="hz-method" id="method">
      <summary>How to read the dates · evidence reviewed {fmt(review.reviewed_at)}</summary>
      <p>{review.decision}</p><p>The arrival windows date from {fmt(review.dates_origin)}. Source publication dates and our review date are shown separately. A new site build does not renew either.</p>
      <p>Optimistic, pragmatic and sceptical describe different assumptions. “Pragmatic” is a scenario label, not a claim of expert consensus or a statistically most likely outcome. The education scenarios include both institutional change and improvement within existing institutions.</p>
      <p>We link primary research and publisher documentation, state their limits, and describe our own interpretation as an assessment. <a href="/horizon/record#next">The separate, testable forecasts</a> retain their September 2026 review and resolution criteria.</p>
      <p><a href="https://github.com/valorifutures/softcat.ai/blob/main/src/data/horizon/outlook-review.json">Inspect this evidence review ↗</a> · <a href="https://github.com/valorifutures/softcat.ai/blob/67964574068c7bfe7b30a076984986ed161a3cad/src/data/horizon/scenarios.json">Read the original scenario wording ↗</a></p>
    </details>
    {legacyIds.map(id => <div class="hz-legacy-anchor" id={id} data-horizon-record><a href={`/horizon/record#${id}`}>This entry is in the supporting Horizon record. Continue to the entry →</a></div>)}
  </div></div>
  <script>
    function followRecordLink() {
      let id: string;
      try { id = decodeURIComponent(window.location.hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (target?.hasAttribute('data-horizon-record')) window.location.replace(`/horizon/record${window.location.search}#${encodeURIComponent(id)}`);
    }
    followRecordLink();
    window.addEventListener('hashchange', followRecordLink);
  </script>
</BaseLayout>
